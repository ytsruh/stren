package emailtmpl

// WeightReminderEmail is the HTML body of the weekly "time to log
// your weight" reminder. It is the transactional counterpart to the
// push notification fired by the same reminder job, so the two share
// the same subject and the same call-to-action: tap the button (or
// the push), land on /weight/new, log the reading, optionally upload
// a photo.
//
// The baseURL is threaded through so a staging deployment sends an
// email that points at itself, not at production.
templ WeightReminderEmail(name string, baseURL string) {
	@EmailLayout("It's Sunday — time to log this week's weight.") {
		@EmailHeader()
		<div style="padding:24px 0 8px 0;">
			@EmailTitle("Sunday weigh-in")
			@EmailParagraph("Hi " + name + ", it's time to log your weight for the week.")
			@EmailParagraph("A single entry a week is the most reliable way to spot a trend without making the scale a daily event. Tap below to add today's reading — and feel free to add a photo if you want to see your progress over time.")
			@EmailButton(baseURL+"/weight/new", "Log this week's weight")
		</div>
		@EmailDivider()
		@EmailFooter(CurrentYear(), baseURL)
	}
}
