package dashboard

import (
	"fmt"
	"sort"
	"stren/internal/models"
	"stren/internal/views"
	"stren/internal/views/components"
	"time"
)

// Dashboard renders the main dashboard page
templ Dashboard(entries []models.ExerciseEntry, userName string, isAuthenticated bool, isAdmin bool) {
	@views.Layout(views.PageData{Title: "Dashboard", UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin}) {
		<section class="mb-8">
			<div class="grid grid-cols-2 gap-2 sm:gap-4">
				@components.ActionCard(components.ActionCardProps{Label: "Add Entry", Href: "/entries/new", Icon: "plus"})
				@components.ActionCard(components.ActionCardProps{Label: "Timer", Href: "/timer", Icon: "timer"})
			</div>
		</section>
		if len(entries) == 0 {
			@views.EmptyState()
		} else {
			<section class="flex flex-col gap-y-4">
				<div class="flex justify-between items-center">
					@components.Title(components.TitleProps{Size: "lg", Color: "default", Title: "7 Day History"})
				</div>
				<div class="card p-4 h-72 sm:h-80">
					@components.DonutChart(popularExercisesChartProps(entries))
				</div>
				@EntryList(entries)
			</section>
		}
	}
}

// EntryList renders a table of entries
templ EntryList(entries []models.ExerciseEntry) {
	<table class="table w-full">
		<thead>
			<tr>
				<th>Date</th>
				<th>Exercise</th>
				<th class="hidden sm:table-cell">Reps</th>
				<th class="hidden sm:table-cell">Weight</th>
				<th class="hidden lg:table-cell">Notes</th>
				<th></th>
			</tr>
		</thead>
		<tbody id="entries-table">
			for _, entry := range entries {
				@EntryRow(entry)
			}
		</tbody>
	</table>
}

// EntryRow renders a single entry row (used for htmx swaps)
templ EntryRow(entry models.ExerciseEntry) {
	<tr id={ fmt.Sprintf("entry-%s", entry.ID) }>
		<td>{ entry.FormattedDate() }</td>
		<td>
			<a href={ templ.SafeURL(fmt.Sprintf("/exercises/%s", entry.ExerciseID)) } class="underline-offset-4 hover:underline inline-flex items-center gap-1">
				@components.Icon(components.IconProps{Name: "eye", Size: 14})
				{ entry.ExerciseName }
			</a>
		</td>
		<td class="hidden sm:table-cell">{ fmt.Sprintf("%d", entry.Reps) }</td>
		<td class="hidden sm:table-cell">{ entry.FormattedWeight() }</td>
		<td class="hidden lg:table-cell">{ entry.Notes }</td>
		<td>
			<div class="flex gap-2">
				<a
					href={ templ.SafeURL(fmt.Sprintf("/entries/%s/edit", entry.ID)) }
					class="btn-outline p-2"
					title="Edit"
				>
					@components.Icon(components.IconProps{Name: "edit", Size: 16})
				</a>
			</div>
		</td>
	</tr>
}

// DeletedRow is returned after deleting an entry (htmx swap)
templ DeletedRow() {
	<tr class="fade-out" style="display: none;"></tr>
}

// RecentEntries shows the most recent entries on the dashboard
templ RecentEntries(entries []models.ExerciseEntry) {
	<section>
		<h2 class="mb-4">Recent Workouts</h2>
		if len(entries) == 0 {
			@views.EmptyState()
		} else {
			@EntryList(entries)
		}
	</section>
}

// QuickStats shows some basic statistics
templ QuickStats(entries []models.ExerciseEntry) {
	<section class="mt-8">
		<h3 class="flex items-center gap-2 mb-4">
			@components.Icon(components.IconProps{Name: "calendar", Size: 20})
			Last 7 Days
		</h3>
		<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
			@components.StatCard(components.StatCardProps{Label: "Total Sets", Value: fmt.Sprintf("%d", len(entries))})
			@components.StatCard(components.StatCardProps{Label: "Unique Exercises", Value: fmt.Sprintf("%d", countUniqueExercises(entries))})
			@components.StatCard(components.StatCardProps{Label: "Total Volume", Value: fmt.Sprintf("%.0f kg", calculateVolume(entries))})
		</div>
	</section>
}

// Helper functions
func countUniqueExercises(entries []models.ExerciseEntry) int {
	seen := make(map[string]bool)
	sevenDaysAgo := time.Now().AddDate(0, 0, -7)
	for _, e := range entries {
		if e.CreatedAt.After(sevenDaysAgo) {
			seen[e.ExerciseName] = true
		}
	}
	return len(seen)
}

func calculateVolume(entries []models.ExerciseEntry) float64 {
	var volume float64
	sevenDaysAgo := time.Now().AddDate(0, 0, -7)
	for _, e := range entries {
		if e.CreatedAt.After(sevenDaysAgo) {
			volume += e.Weight
		}
	}
	return volume
}

// popularExercisesTopN is the maximum number of slices the popular
// exercises donut renders individually. Anything beyond is collapsed
// into an "Other" bucket so the chart stays readable on mobile.
const popularExercisesTopN = 5

// popularExercisesOtherLabel is the slice label for exercises that
// didn't make it into the top-N bucket.
const popularExercisesOtherLabel = "Other"

// popularExercisesOtherColor is the neutral gray slice color for the
// "Other" bucket. Picked to visually de-emphasise the bucket so the
// eye focuses on the top-N brand shades. The top-N slices get their
// colors from the donut chart's default brand palette (delegated via
// empty-string entries in DonutChartProps.Colors) so a brand refresh
// stays a single-file change.
const popularExercisesOtherColor = "#9ca3af"

// popularExercisesChartID is the canvas id used for the popular
// exercises donut. Exposed as a constant so views and tests can refer
// to it without duplicating the string.
const popularExercisesChartID = "popular-exercises-chart"

// popularExercisesChartTitle is the heading rendered above the donut.
const popularExercisesChartTitle = "Most Popular Exercises (7d)"

// popularExercisesChartProps groups a slice of ExerciseEntry by
// exercise name, counts the number of sets per exercise, and returns
// the DonutChartProps needed to render the dashboard's "Most Popular
// Exercises (7d)" donut. Up to popularExercisesTopN exercises are
// returned individually; the rest are collapsed into an "Other" bucket
// so the chart stays readable. Each entry is counted as a single set
// to match the dashboard's "Total Sets" stat semantics. A donut with
// zero slices is not meaningful, so callers should also gate on
// len(entries) > 0 before rendering.
//
// Sorting is by count desc, then by name asc, so the slice order is
// fully deterministic and stable.
func popularExercisesChartProps(entries []models.ExerciseEntry) components.DonutChartProps {
	counts := make(map[string]int)
	for _, e := range entries {
		counts[e.ExerciseName]++
	}

	type bucket struct {
		name  string
		count int
	}
	buckets := make([]bucket, 0, len(counts))
	for name, c := range counts {
		buckets = append(buckets, bucket{name, c})
	}
	sort.Slice(buckets, func(i, j int) bool {
		if buckets[i].count != buckets[j].count {
			return buckets[i].count > buckets[j].count
		}
		return buckets[i].name < buckets[j].name
	})

	labels := make([]string, 0, popularExercisesTopN+1)
	values := make([]float64, 0, popularExercisesTopN+1)
	var otherCount int
	hasOther := len(buckets) > popularExercisesTopN
	if !hasOther {
		for _, b := range buckets {
			labels = append(labels, b.name)
			values = append(values, float64(b.count))
		}
	} else {
		for _, b := range buckets[:popularExercisesTopN] {
			labels = append(labels, b.name)
			values = append(values, float64(b.count))
		}
		for _, b := range buckets[popularExercisesTopN:] {
			otherCount += b.count
		}
		labels = append(labels, popularExercisesOtherLabel)
		values = append(values, float64(otherCount))
	}

	props := components.DonutChartProps{
		ID:     popularExercisesChartID,
		Title:  popularExercisesChartTitle,
		Labels: labels,
		Values: values,
	}
	if hasOther {
		// Override only the "Other" slice with the neutral gray. The
		// top-N slots stay as "" so DonutChart fills them from its
		// default brand palette — see DonutChartProps.Colors for the
		// empty-string contract.
		colors := make([]string, popularExercisesTopN+1)
		colors[popularExercisesTopN] = popularExercisesOtherColor
		props.Colors = colors
	}
	return props
}
