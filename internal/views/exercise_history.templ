package views

import (
	"fmt"
	"stren/internal/models"
)

// ExerciseHistory shows all entries for a specific exercise
templ ExerciseHistory(exerciseName string, entries []models.ExerciseEntry, userName string, isAuthenticated bool) {
	@Layout(PageData{Title: exerciseName, UserName: userName, IsAuthenticated: isAuthenticated}) {
		<div class="flex justify-between items-center mb-2">
			<h1 class="flex items-center gap-1">
				@Icon(IconProps{Name: "dumbbell", Size: 24})
				{ exerciseName }
			</h1>
		</div>
		if len(entries) == 0 {
			<article>
				<header>
					<h3>No entries yet</h3>
				</header>
				<p>You haven't logged any sets for { exerciseName } yet.</p>
				<footer>
					<a href="/entries/new" role="button" class="flex items-center gap-1">
						@Icon(IconProps{Name: "plus", Size: 18})
						Log First Set
					</a>
				</footer>
			</article>
		} else {
			@ExerciseStats(entries)
			<h3 class="flex items-center gap-1">
				@Icon(IconProps{Name: "trending-up", Size: 20})
				History
			</h3>
			<table>
				<thead>
					<tr>
						<th>Date</th>
						<th>Reps</th>
						<th>Weight</th>
						<th>Notes</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, entry := range entries {
						<tr id={ fmt.Sprintf("entry-%d", entry.ID) }>
							<td>{ entry.FormattedDate() }</td>
							<td>{ fmt.Sprintf("%d", entry.Reps) }</td>
							<td>{ entry.FormattedWeight() }</td>
							<td>{ entry.Notes }</td>
							<td>
								<div class="flex gap-1">
									<a
										href={ templ.SafeURL(fmt.Sprintf("/entries/%d/edit", entry.ID)) }
										class="button"
										role="button"
										title="Edit"
									>
										@Icon(IconProps{Name: "edit", Size: 16})
									</a>
									<button
										title="Delete"
										data-variant="danger"
										hx-delete={ fmt.Sprintf("/entries/%d", entry.ID) }
										hx-confirm="Delete this entry?"
										hx-target={ fmt.Sprintf("#entry-%d", entry.ID) }
										hx-swap="outerHTML swap:0.3s"
									>
										@Icon(IconProps{Name: "trash", Size: 16})
									</button>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}

// ExerciseStats shows statistics for an exercise
templ ExerciseStats(entries []models.ExerciseEntry) {
	<h3 class="flex items-center gap-1">
		@Icon(IconProps{Name: "trending-up", Size: 20})
		Stats
	</h3>
	<div class="flex gap-1">
		@StatCard("Personal Best", fmt.Sprintf("%.1f kg", maxWeight(entries)))
		@StatCard("Last Set", getLastSet(entries))
	</div>
}

// Helper functions
func maxWeight(entries []models.ExerciseEntry) float64 {
	if len(entries) == 0 {
		return 0
	}
	max := entries[0].Weight
	for _, e := range entries[1:] {
		if e.Weight > max {
			max = e.Weight
		}
	}
	return max
}

func getLastSet(entries []models.ExerciseEntry) string {
	if len(entries) == 0 {
		return "No entries"
	}
	// Entries are sorted by created_at DESC, so first is the most recent
	last := entries[0]
	return fmt.Sprintf("%.1f kg × %d", last.Weight, last.Reps)
}
