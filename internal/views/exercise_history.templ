package views

import (
	"fmt"
	"stren/internal/models"
	"stren/internal/views/components"
)

// ExerciseHistory shows all entries for a specific exercise
templ ExerciseHistory(exerciseName string, entries []models.ExerciseEntry, userName string, isAuthenticated bool, isAdmin bool) {
	@Layout(PageData{Title: exerciseName, UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin}) {
		@components.Title(components.TitleProps{Size: "lg", Color: "default", Title: exerciseName})
		if len(entries) == 0 {
			<div class="flex min-w-0 flex-1 flex-col items-center justify-center gap-6 rounded-lg border-dashed border-2 p-12 text-center">
				<header class="flex max-w-sm flex-col items-center gap-3 text-center">
					<div class="mb-4 bg-muted text-foreground flex size-12 shrink-0 items-center justify-center rounded-lg">
						@components.Icon(components.IconProps{Name: "dumbbell", Size: 24})
					</div>
					@components.Title(components.TitleProps{Size: "md", Color: "default", Title: "No entries yet"})
					<p class="text-muted-foreground text-sm">You haven't logged any sets for { exerciseName } yet.</p>
				</header>
				<section class="flex w-full max-w-sm min-w-0 flex-col items-center gap-3">
					<a href="/entries/new" class="btn">
						@components.Icon(components.IconProps{Name: "plus", Size: 18})
						Log First Set
					</a>
				</section>
			</div>
		} else {
			@ExerciseStats(entries)
			<h3 class="flex items-center gap-2 mb-4">
				@components.Icon(components.IconProps{Name: "trending-up", Size: 20})
				History
			</h3>
			<div class="overflow-x-auto">
				<table class="table">
					<thead>
						<tr>
							<th>Date</th>
							<th>Reps</th>
							<th>Weight</th>
							<th>Notes</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						for _, entry := range entries {
							<tr id={ fmt.Sprintf("entry-%d", entry.ID) }>
								<td>{ entry.FormattedDate() }</td>
								<td>{ fmt.Sprintf("%d", entry.Reps) }</td>
								<td>{ entry.FormattedWeight() }</td>
								<td>{ entry.Notes }</td>
								<td>
									<div class="flex gap-2">
										<a
											href={ templ.SafeURL(fmt.Sprintf("/entries/%d/edit", entry.ID)) }
											class="btn-outline p-2"
											title="Edit"
										>
											@components.Icon(components.IconProps{Name: "edit", Size: 16})
										</a>
										<button
											class="btn-destructive p-2"
											title="Delete"
											hx-delete={ fmt.Sprintf("/entries/%d", entry.ID) }
											hx-confirm="Delete this entry?"
											hx-target={ fmt.Sprintf("#entry-%d", entry.ID) }
											hx-swap="outerHTML swap:0.3s"
										>
											@components.Icon(components.IconProps{Name: "trash", Size: 16})
										</button>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

// ExerciseStats shows statistics for an exercise
templ ExerciseStats(entries []models.ExerciseEntry) {
	<h3 class="flex items-center gap-2 mb-4">
		@components.Icon(components.IconProps{Name: "trending-up", Size: 20})
		Stats
	</h3>
	<div class="w-full grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
		@components.StatCard(components.StatCardProps{Label: "Last Set", Value: getLastSet(entries)})
		@components.StatCard(components.StatCardProps{Label: "Personal Best", Value: fmt.Sprintf("%.1f kg", maxWeight(entries))})
	</div>
}

// Helper functions
func maxWeight(entries []models.ExerciseEntry) float64 {
	if len(entries) == 0 {
		return 0
	}
	max := entries[0].Weight
	for _, e := range entries[1:] {
		if e.Weight > max {
			max = e.Weight
		}
	}
	return max
}

func getLastSet(entries []models.ExerciseEntry) string {
	if len(entries) == 0 {
		return "No entries"
	}
	last := entries[0]
	return fmt.Sprintf("%.1f kg × %d", last.Weight, last.Reps)
}
