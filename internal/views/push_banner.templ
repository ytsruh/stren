package views

import "stren/internal/views/components"

// PushBanner renders the "Notifications" card on the user's profile
// page. Behaviour lives in /js/push.js; this template just provides
// the markup and a few data attributes the JS reads to bootstrap
// itself.
//
// Three display states the JS drives via the `data-state` attribute:
//
//   - "disabled":    no active subscription; show Enable button
//   - "enabled":     active subscription; show Disable button
//   - "unsupported": browser can't subscribe (no PushManager, denied
//                    permission, etc.); show a message and a
//                    Re-check button. The card body swaps via the
//                    `.push-content` / `.push-unsupported` pair so
//                    the card itself stays visible and a user with
//                    no notifications support still sees context.
//
// `configured` is set to false when the server has no VAPID keys
// (which shouldn't happen in production — LoadOrGenerate creates
// them on first boot — but keeps the UI honest in tests and on a
// freshly-wiped /data volume). When unconfigured the entire card
// is hidden.
templ PushBanner(hasSubscription bool, vapidPublicKey string, configured bool) {
	if configured {
		@components.Card(components.CardProps{}) {
			@components.CardSection(components.CardSectionProps{}) {
				<div
					id="push-banner"
					class="push-banner"
					data-state={ initialPushState(hasSubscription) }
					data-vapid-key={ vapidPublicKey }
				>
					<div class="push-content">
						<div>
							<h3>Notifications</h3>
							<p class="text-sm text-muted-foreground">Get notified when the admin sends an announcement.</p>
						</div>
						<div class="push-actions flex gap-2 items-center">
							<span id="push-status" class="push-status">{ pushStatusLabel(hasSubscription) }</span>
							<button id="push-enable" type="button" class="btn-primary push-btn">Enable</button>
							<button id="push-disable" type="button" class="btn-outline push-btn">Disable</button>
							<span id="push-spinner" class="push-spinner" aria-hidden="true">
								@components.Icon(components.IconProps{Name: "loader", Size: 18})
							</span>
						</div>
					</div>
					<div id="push-unsupported" class="push-unsupported" hidden>
						<div class="push-unsupported-inner">
							<p class="push-unsupported-label">Push notifications unavailable</p>
							<p class="push-unsupported-reason" id="push-unsupported-reason">This browser does not support web push.</p>
							<div class="flex gap-2 mt-3 flex-wrap">
								<button id="push-recheck" type="button" class="btn-outline">Re-check support</button>
							</div>
						</div>
					</div>
				</div>
			}
		}
	}
}

// initialPushState is the data-state value used for first paint.
// Server-side best guess: if the user has at least one stored
// subscription, mark as "enabled". The JS will reconcile with the
// browser's actual pushManager state on load and update if needed.
func initialPushState(hasSubscription bool) string {
	if hasSubscription {
		return "enabled"
	}
	return "disabled"
}

// pushStatusLabel returns the human-readable status text shown next
// to the buttons.
func pushStatusLabel(hasSubscription bool) string {
	if hasSubscription {
		return "Enabled"
	}
	return "Disabled"
}

// PushSubscribeSuccess renders a success toast for HTMX responses
// after a successful subscription.
templ PushSubscribeSuccess() {
	@Toast("success", "Notifications enabled", "You'll receive admin messages.")
}

// PushUnsubscribeSuccess renders a success toast for HTMX responses
// after a successful unsubscribe.
templ PushUnsubscribeSuccess() {
	@Toast("success", "Notifications disabled", "")
}

// PushSubscribeError renders an error toast for HTMX responses.
templ PushSubscribeError(message string) {
	@Toast("error", "Notifications", message)
}
