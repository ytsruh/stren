package goals

import (
	"fmt"
	"time"

	"stren/internal/models"
	"stren/internal/views"
	"stren/internal/views/components"
)

// GoalsPage renders the full goals list page. The goals slice is
// split into active and completed groups in a single pass; active
// goals are always shown first, and completed goals live inside a
// collapsible Basecoat accordion (closed by default) so they
// don't clutter the page when the user has finished several.
//
// Both sections are wrapped in containers with stable ids and
// hx-swap-oob="true" so the Mark Complete and Reopen actions can
// OOB-swap them in place. The completed wrapper is always in the
// DOM (with class="hidden" when empty) so the OOB swap target
// exists even when there's nothing to show.
//
// When there are no goals at all, the page-level empty state
// (GoalsEmptyState) takes over. When the user has completed goals
// but no active ones, the "Active goals" section still renders
// with a small in-section hint pointing at /goals/new — better
// discoverability than silently hiding the section.
templ GoalsPage(goals []models.Goal, userName string, isAuthenticated bool, isAdmin bool) {
	{{ active, completed := splitGoals(goals) }}
	@views.Layout(views.PageData{Title: "Goals", UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin}) {
		<div class="flex justify-between items-center mb-6">
			@components.Title(components.TitleProps{Size: "lg", Color: "default", Title: "Goals"})
			<div class="flex items-center gap-2">
				<a href="/goals/new" class="btn">
					@components.Icon(components.IconProps{Name: "plus", Size: 18})
					Add Goal
				</a>
			</div>
		</div>
		if len(goals) == 0 {
			@GoalsEmptyState()
		} else {
			<div class="flex flex-col gap-6">
				@ActiveGoalsSection(active, isAdmin)
				@CompletedGoalsSection(completed, isAdmin)
			</div>
		}
		@GoalsConfettiScript()
		@GoalsEventListenerScript()
	}
}

// ActiveGoalsSection renders the active-goals section wrapper
// (header + body). The outer div is OOB-swappable so the
// Mark Complete and Reopen actions can update the whole section
// in one round trip — which is how a card "moves" from active
// to completed without a page reload.
//
// The body is either the list of active goal cards, or an
// in-section hint ("No active goals — add one") when the user
// has completed goals but none active. The hint is rendered
// inline (not as a separate template) so the OOB swap target
// stays a single element.
templ ActiveGoalsSection(active []models.Goal, isAdmin bool) {
	<div id="active-goals-section" hx-swap-oob="true">
		@GoalsSectionHeader("Active goals", len(active))
		<div id="active-goals-body" class="flex flex-col gap-2">
			if len(active) == 0 {
				@GoalsEmptyActiveHint()
			} else {
				for _, g := range active {
					@GoalCard(g, true, isAdmin)
				}
			}
		</div>
	</div>
}

// CompletedGoalsSection renders the completed-goals section
// wrapper. The wrapper is always in the DOM so the OOB swap
// target exists; when there are no completed goals, the wrapper
// carries class="hidden" so it doesn't take up visual space.
//
// The Basecoat accordion pattern (native <details> + <summary>)
// is rendered inside. Closed by default so finished goals don't
// take up space on initial load; the user clicks the header to
// expand. The chevron icon and the count inside the summary
// update via the OOB swap of the wrapper when goals move.
templ CompletedGoalsSection(completed []models.Goal, isAdmin bool) {
	<div
		id="completed-goals-section"
		hx-swap-oob="true"
		if len(completed) == 0 {
			class="hidden"
		}
	>
		<div class="accordion">
			<details>
				<summary class="flex items-center gap-2 cursor-pointer">
					<h2 class="text-sm font-semibold text-foreground">Completed goals</h2>
					<span class="text-xs text-muted-foreground">·</span>
					<span class="text-xs text-muted-foreground">{ fmt.Sprintf("%d", len(completed)) }</span>
					@components.Icon(components.IconProps{Name: "chevron-down", Size: 16, Class: "ml-auto transition-transform group-open:rotate-180"})
				</summary>
				<section id="completed-goals-body" class="flex flex-col gap-2 pt-2">
					for _, g := range completed {
						@GoalCard(g, true, isAdmin)
					}
				</section>
			</details>
		</div>
	</div>
}

// GoalsSections composes the active and completed section wrappers
// for the OOB-swap response used by the Mark Complete and Reopen
// actions. The two wrappers carry hx-swap-oob="true" so htmx
// replaces both in the DOM in a single round trip — the result
// is the card "moving" from one section to the other without a
// page reload.
//
// Note: OOB-swapping the completed section does reset the
// <details> open state. That's accepted as a minor cost — the
// user can re-expand the accordion if they had it open.
templ GoalsSections(goals []models.Goal, isAdmin bool) {
	{{ active, completed := splitGoals(goals) }}
	@ActiveGoalsSection(active, isAdmin)
	@CompletedGoalsSection(completed, isAdmin)
}

// GoalsSectionHeader renders a small section heading with the
// title, a count after a middle dot, and a thin divider beneath.
// Used for the "Active goals" header; the completed section uses
// the same title format inside the accordion summary instead.
templ GoalsSectionHeader(title string, count int) {
	<div class="flex items-baseline gap-2 mb-2">
		<h2 class="text-sm font-semibold text-foreground">{ title }</h2>
		<span class="text-xs text-muted-foreground">·</span>
		<span class="text-xs text-muted-foreground">{ fmt.Sprintf("%d", count) }</span>
	</div>
	<div class="border-t border-border mb-3"></div>
}

// GoalsEmptyActiveHint shows inside the Active section when the
// user has completed some goals but none active. Keeps the section
// visible (so there's still somewhere to click to add a new goal)
// without taking up the visual real estate of the page-level empty
// state.
templ GoalsEmptyActiveHint() {
	<div class="card px-4 py-3 flex items-center justify-between gap-3 text-sm text-muted-foreground">
		<span>No active goals — add one to get started.</span>
		<a href="/goals/new" class="btn-sm">
			@components.Icon(components.IconProps{Name: "plus", Size: 14})
			Add
		</a>
	</div>
}

// CompletedGoalsAccordion was removed when the completed section
// was promoted to CompletedGoalsSection (a wrapper with
// hx-swap-oob="true" so the Mark Complete / Reopen actions can
// move cards between sections in a single round trip). The
// accordion markup itself still lives in CompletedGoalsSection.

// GoalCard renders a single goal as a compact, single-line card.
// The wrapper carries id="goal-{id}" and hx-swap-oob="true" so the
// same component can be the initial-render target on the list AND
// the OOB swap response from the in-place action endpoints (mark
// complete, reopen). Htmx ignores hx-swap-oob on initial render so
// there's no need for a separate "list" variant of the card.
//
// Layout (left → right):
//   - status dot (• active, ✓ completed)
//   - title (truncates; line-through when complete)
//   - inline date chips for start / target / end
//   - "Due in N days" hint (active goals with a future target)
//   - action buttons (Mark Complete / Reopen, Edit)
templ GoalCard(g models.Goal, isAuthenticated bool, isAdmin bool) {
	<article
		id={ "goal-" + g.ID }
		if g.IsComplete() {
			class="card px-4 py-2 opacity-60"
		} else {
			class="card px-4 py-2"
		}
		hx-swap-oob="true"
	>
		<div class="flex gap-3 items-center">
			<span
				class={ templ.Classes(
				"size-2 rounded-full shrink-0",
				map[string]bool{"bg-muted-foreground": g.IsComplete(), "bg-primary": !g.IsComplete()},
			) }
			></span>
			<div class="flex-1 min-w-0 flex items-center gap-2">
				if g.IsComplete() {
					<span class="font-medium truncate line-through" title={ g.Title }>{ g.Title }</span>
				} else {
					<span class="font-medium truncate" title={ g.Title }>{ g.Title }</span>
				}
			</div>
			@GoalDateInline(g)
			@GoalActionRow(g, isAuthenticated, isAdmin)
		</div>
	</article>
}

// GoalDateInline renders the date chips as inline short text so
// the whole card fits on one row. Completed goals show the
// completion date instead of the relative "due in N days" hint.
templ GoalDateInline(g models.Goal) {
	{{ days := g.DaysUntilTarget(currentTime()) }}
	<div class="hidden md:flex items-center gap-2 text-xs text-muted-foreground shrink-0">
		if g.StartDate != nil {
			<span title={ "Started " + models.FormatGoalDate(g.StartDate) }>Started { shortGoalDate(g.StartDate) }</span>
		}
		if g.TargetDate != nil {
			<span class="text-border">·</span>
			<span title={ "Target " + models.FormatGoalDate(g.TargetDate) }>Target { shortGoalDate(g.TargetDate) }</span>
			if !g.IsComplete() && days != nil {
				if *days == 0 {
					<span class="badge bg-primary text-primary-foreground text-[10px] px-1.5 py-0">Today</span>
				} else {
					<span class="badge bg-primary text-primary-foreground text-[10px] px-1.5 py-0">{ fmt.Sprintf("%dd", *days) }</span>
				}
			}
		}
		if g.EndDate != nil {
			<span class="text-border">·</span>
			<span title={ "Ended " + models.FormatGoalDate(g.EndDate) }>Ended { shortGoalDate(g.EndDate) }</span>
		}
		if g.IsComplete() {
			<span class="badge bg-secondary text-secondary-foreground text-[10px] px-1.5 py-0">Done { g.FormattedCompletedDate() }</span>
		}
	</div>
}

// GoalActionRow renders the Mark Complete / Reopen and Edit
// buttons. Delete is intentionally NOT on the list view — it lives
// only on the edit form (see form.templ). The in-place actions
// (mark complete, reopen) target the card itself with hx-swap="none"
// so htmx only processes the OOB card swap returned by the route.
templ GoalActionRow(g models.Goal, isAuthenticated bool, isAdmin bool) {
	<div class="flex items-center gap-1 shrink-0">
		if g.IsComplete() {
			<button
				type="button"
				class="btn-sm-outline"
				title="Reopen"
				aria-label="Reopen"
				hx-post={ fmt.Sprintf("/goals/%s/reopen", g.ID) }
				hx-target={ fmt.Sprintf("#goal-%s", g.ID) }
				hx-swap="none"
			>
				@components.Icon(components.IconProps{Name: "undo", Size: 14})
			</button>
		} else {
			<button
				type="button"
				class="btn-sm"
				title="Mark Complete"
				aria-label="Mark Complete"
				hx-post={ fmt.Sprintf("/goals/%s/complete", g.ID) }
				hx-target={ fmt.Sprintf("#goal-%s", g.ID) }
				hx-swap="none"
			>
				@components.Icon(components.IconProps{Name: "check", Size: 14})
			</button>
		}
		<a
			href={ templ.SafeURL(fmt.Sprintf("/goals/%s/edit", g.ID)) }
			class="btn-sm-outline"
			title="Edit"
			aria-label="Edit"
		>
			@components.Icon(components.IconProps{Name: "edit", Size: 14})
		</a>
	</div>
}

// GoalsEmptyState shows when the user has no goals at all.
templ GoalsEmptyState() {
	<div class="flex min-w-0 flex-1 flex-col items-center justify-center gap-6 rounded-lg border-dashed border-2 p-12 text-center">
		<header class="flex max-w-sm flex-col items-center gap-3 text-center">
			<div class="mb-4 bg-muted text-foreground flex size-12 shrink-0 items-center justify-center rounded-lg">
				@components.Icon(components.IconProps{Name: "target", Size: 24})
			</div>
			<h3 class="text-lg font-semibold">No goals yet</h3>
			<p class="text-muted-foreground text-sm">Track what you're working towards. Goals can have optional start, target, and end dates.</p>
		</header>
		<section class="flex w-full max-w-sm min-w-0 flex-col items-center gap-3">
			<a href="/goals/new" class="btn">
				@components.Icon(components.IconProps{Name: "plus", Size: 18})
				Add Your First Goal
			</a>
		</section>
	</div>
}

// GoalsConfettiScript is the inline script that fires the
// celebration burst on the goalCompleted event. Lives at the
// bottom of the goals list page only; the canvas-confetti library
// is loaded by the layout. Guarded by typeof confetti so a
// blocked CDN doesn't break the page.
templ GoalsConfettiScript() {
	<script>
		document.body.addEventListener('goalCompleted', function() {
			if (typeof confetti !== 'function') return;
			confetti({ particleCount: 120, spread: 80, origin: { y: 0.6 } });
			setTimeout(function() {
				confetti({ particleCount: 60, spread: 100, origin: { y: 0.5, x: 0.3 } });
				confetti({ particleCount: 60, spread: 100, origin: { y: 0.5, x: 0.7 } });
			}, 200);
		});
	</script>
}

// GoalsEventListenerScript wires up the client-side handlers for
// goal-side events. Htmx dispatches them after each request:
//   - goalCompleted: fired by the route on successful Mark Complete.
//     The confetti script above fires the burst.
//   - goalCreated, goalUpdated, goalReopened, goalDeleted:
//     triggered by create / update / reopen / delete responses.
//     We show a toast for each so the user gets explicit feedback.
templ GoalsEventListenerScript() {
	<script>
		(function() {
			function showGoalToast(category, title, description) {
				// Reuse the layout's hidden toast templates so the
				// markup (icon, classes) lives in exactly one place.
				var toaster = document.getElementById('toaster');
				var template = document.getElementById('toast-template-' + category) || document.getElementById('toast-template-default');
				if (!toaster || !template) return;
				var clone = template.content.cloneNode(true);
				var h2 = clone.querySelector('[data-toast-title]');
				if (h2) h2.textContent = title;
				var p = clone.querySelector('[data-toast-description]');
				if (p) {
					if (description) {
						p.textContent = description;
						p.classList.remove('hidden');
					} else {
						p.remove();
					}
				}
				toaster.appendChild(clone);
			}

			document.body.addEventListener('goalCreated',  function() { showGoalToast('success', 'Goal saved!',    ''); });
			document.body.addEventListener('goalUpdated',  function() { showGoalToast('success', 'Goal updated!', ''); });
			document.body.addEventListener('goalReopened', function() { showGoalToast('success', 'Goal reopened', 'Marked as active again.'); });
			document.body.addEventListener('goalDeleted',  function() { showGoalToast('success', 'Goal deleted',  ''); });
		})();
	</script>
}

// shortGoalDate renders a *time.Time as a compact "DD MMM" string
// (e.g. "12 May") for the inline date chips on the single-line
// card. Returns "" for a nil pointer so the caller can render the
// chip conditionally.
func shortGoalDate(t *time.Time) string {
	if t == nil {
		return ""
	}
	return t.Format("02 Jan")
}

// splitGoals walks a goals slice once and returns (active, completed).
// The repository already returns goals ordered active-first then
// completed, but a single-pass split keeps the view layer
// resilient if that ordering ever changes (the view doesn't care
// which slice is which; the labels "Active goals" / "Completed
// goals" come from the IsComplete check).
func splitGoals(goals []models.Goal) (active []models.Goal, completed []models.Goal) {
	for _, g := range goals {
		if g.IsComplete() {
			completed = append(completed, g)
		} else {
			active = append(active, g)
		}
	}
	return active, completed
}

// currentTime returns the current time. Wrapped so the templ
// expression for the days-until-target hint stays short and so
// tests can substitute a fixed clock if they need to.
var currentTime = func() (t timeT) { return timeNow() }
