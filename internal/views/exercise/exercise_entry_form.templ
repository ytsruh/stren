package exercise

import (
	"fmt"
	"stren/internal/models"
	"stren/internal/views"
	"stren/internal/views/components"
	"time"
)

// exerciseSetRow renders a single set's input row inside the new-exercise-entry
// form. The index argument is interpolated into the bracket-notation field
// names (sets[N][reps], etc.) so the server-side parseExerciseEntrySets can
// group the values back into per-set structs. The remove button is wired up
// via data attributes — see exerciseEntryFormSetScript for the add/remove
// logic.
//
// weightUnit is the user's preferred unit ("kg" / "lbs") and drives the
// weight input's label so the form reflects the user's setting rather than
// always showing "(kg)".
//
// Layout: on mobile (<sm) the label and X button form a header row and the
// three inputs stack vertically beneath it as full-width fields. At sm: and
// above the header wrapper switches to display:contents (sm:contents) so its
// children join the parent grid as direct items, giving the original
// five-column row (label · reps · weight · rest · X).
templ exerciseSetRow(index int, weightUnit string) {
	<div class="grid gap-3 sm:grid-cols-[auto_1fr_1fr_1fr_auto] sm:items-end sm:gap-3" data-set-row>
		<div class="flex items-center justify-between sm:contents">
			<div class="pb-0 sm:pb-2 text-sm font-medium text-muted-foreground" data-set-label>
				{ fmt.Sprintf("Set %d", index+1) }
			</div>
			<button
				type="button"
				class="btn-sm-icon-outline sm:order-5"
				data-remove-set
				aria-label="Remove set"
				title="Remove set"
			>
				@components.Icon(components.IconProps{Name: "x", Size: 14})
			</button>
		</div>
		<div class="grid gap-2">
			<label class="text-sm">Reps</label>
			<input
				class="input"
				type="number"
				inputmode="numeric"
				name={ fmt.Sprintf("sets[%d][reps]", index) }
				min="1"
				placeholder="8"
				required
			/>
		</div>
		<div class="grid gap-2">
			<label class="text-sm">Weight ({ weightUnit })</label>
			<input
				class="input"
				type="number"
				inputmode="decimal"
				name={ fmt.Sprintf("sets[%d][weight]", index) }
				step="0.5"
				min="0"
				placeholder="0.0"
				required
			/>
		</div>
		<div class="grid gap-2">
			<label class="text-sm">Rest (s)</label>
			<input
				class="input"
				type="number"
				inputmode="numeric"
				name={ fmt.Sprintf("sets[%d][rest_time]", index) }
				min="0"
				max="3600"
				placeholder="0"
			/>
		</div>
	</div>
}

// exerciseSetRowPlaceholder is rendered only inside the <template> element
// that the inline script clones to add new rows. It uses the literal
// placeholder string __INDEX__ in field names; the script substitutes it for
// the next available index at clone time. The weight label is rendered as a
// literal "Weight (kg)" here because the cloning script doesn't have access
// to the per-request weight unit; the visible rows are what matter for first
// paint, and the unit shown in the form header (see ExerciseEntryForm) gives
// the user the correct context. Layout matches exerciseSetRow so cloned rows
// look identical to the starter rows.
//
// IMPORTANT: this template must stay in lockstep with exerciseSetRow — every
// input attribute the visible row sets (type, inputmode, step, min, max,
// required) must be repeated here. If they drift, the first visible row and
// later cloned rows will render with different mobile keyboards, which is
// exactly the bug inputmode guards against.
templ exerciseSetRowPlaceholder() {
	<div class="grid gap-3 sm:grid-cols-[auto_1fr_1fr_1fr_auto] sm:items-end sm:gap-3" data-set-row>
		<div class="flex items-center justify-between sm:contents">
			<div class="text-sm font-medium text-muted-foreground" data-set-label>Set __INDEX__</div>
			<button type="button" class="btn-sm-icon-outline sm:order-5" data-remove-set aria-label="Remove set" title="Remove set">
				@components.Icon(components.IconProps{Name: "x", Size: 14})
			</button>
		</div>
		<div class="grid gap-2">
			<label class="text-sm">Reps</label>
			<input class="input" type="number" inputmode="numeric" name="sets[__INDEX__][reps]" min="1" placeholder="8" required/>
		</div>
		<div class="grid gap-2">
			<label class="text-sm">Weight (kg)</label>
			<input class="input" type="number" inputmode="decimal" name="sets[__INDEX__][weight]" step="0.5" min="0" placeholder="0.0" required/>
		</div>
		<div class="grid gap-2">
			<label class="text-sm">Rest (s)</label>
			<input class="input" type="number" inputmode="numeric" name="sets[__INDEX__][rest_time]" min="0" max="3600" placeholder="0"/>
		</div>
	</div>
}

// exerciseEntryFormSetScript is the small inline script that powers
// add/remove for the multi-set form. We use vanilla JS (no htmx round-trip)
// so adding or removing a row is instant. Indices are renumbered on every
// change so the server always sees a contiguous 0..N-1 sequence, matching
// the parseExerciseEntrySets grouping logic on the server. The max-set cap
// is read at runtime from the form's data-max-sets attribute so the server
// and client share a single source of truth (views.MaxSetsPerExerciseEntry).
//
// The clone template (#exercise-entry-set-template) lives at the top of the
// page outside the <form>, so it's looked up by ID via getElementById
// rather than form.querySelector. The Add handler is only bound when the
// template is found; the Remove handler is bound unconditionally so a
// missing template doesn't silently disable row removal.
templ exerciseEntryFormSetScript() {
	<script>
		(function() {
			var form = document.getElementById('exercise-entry-form');
			if (!form) return;
			var MAX_SETS = parseInt(form.getAttribute('data-max-sets') || '10', 10);
			var list = form.querySelector('[data-set-list]');
			var addBtn = form.querySelector('[data-add-set]');
			if (!list || !addBtn) return;
			var tpl = document.getElementById('exercise-entry-set-template');

			function renumber() {
				var rows = list.querySelectorAll('[data-set-row]');
				rows.forEach(function(row, i) {
					row.querySelectorAll('[name]').forEach(function(input) {
						input.name = input.name.replace(/sets\[\d+\]/, 'sets[' + i + ']');
					});
					var label = row.querySelector('[data-set-label]');
					if (label) label.textContent = 'Set ' + (i + 1);
				});
				addBtn.disabled = rows.length >= MAX_SETS;
				addBtn.title = rows.length >= MAX_SETS
					? 'Maximum ' + MAX_SETS + ' sets per exercise entry'
					: 'Add another set';
			}

			if (tpl) {
				addBtn.addEventListener('click', function() {
					if (list.querySelectorAll('[data-set-row]').length >= MAX_SETS) return;
					var idx = list.querySelectorAll('[data-set-row]').length;
					var clone = tpl.content.firstElementChild.cloneNode(true);
					clone.querySelectorAll('[name]').forEach(function(input) {
						input.name = input.name.replace(/__INDEX__/g, String(idx));
					});
					var label = clone.querySelector('[data-set-label]');
					if (label) label.textContent = 'Set ' + (idx + 1);
					list.appendChild(clone);
					renumber();
				});
			}

			list.addEventListener('click', function(ev) {
				var btn = ev.target.closest('[data-remove-set]');
				if (!btn) return;
				var row = btn.closest('[data-set-row]');
				if (!row) return;
				if (list.querySelectorAll('[data-set-row]').length <= 1) return;
				row.remove();
				renumber();
			});

			renumber();
		})();
	</script>
}

// ExerciseEntryForm renders the form for creating a new exercise entry.
// preselectedExerciseID, when non-empty, marks the matching <option> as selected.
// weightUnit is the user's preferred unit and drives the weight input label.
templ ExerciseEntryForm(exercises []models.Exercise, preselectedExerciseID string, userName string, isAuthenticated bool, isAdmin bool, weightUnit string) {
	@views.Layout(views.PageData{Title: "New Set", UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin}) {
		@components.Title(components.TitleProps{Size: "lg", Color: "default", Title: "New Set"})
		<form
			id="exercise-entry-form"
			hx-post="/exercise-entries"
			hx-target="#toaster"
			hx-swap="beforeend"
			class="py-2 form grid gap-6"
			data-max-sets={ fmt.Sprintf("%d", views.MaxSetsPerExerciseEntry) }
		>
			<fieldset class="grid gap-4">
				// Exercise + date sit side-by-side at sm: and above, stack on
				// mobile. items-end aligns the input boxes at the bottom of
				// each column so the visually-aligned parts (the inputs)
				// match up regardless of label height.
				<div class="grid gap-4 sm:grid-cols-2 sm:items-end">
					<div class="grid gap-2">
						<label for="exercise-name">Exercise</label>
						<select
							id="exercise-name"
							name="exercise_id"
							class="select"
							required
						>
							<option value="">-- Select an exercise --</option>
							for _, e := range exercises {
								if e.ID == preselectedExerciseID {
									<option value={ e.ID } selected>{ e.Name }</option>
								} else {
									<option value={ e.ID }>{ e.Name }</option>
								}
							}
						</select>
					</div>
					<div class="grid gap-2">
						<label for="exercise-entry-date">Date & Time</label>
						<input
							class="input"
							type="datetime-local"
							id="exercise-entry-date"
							name="created_at"
							value={ views.FormatDateTimeLocal(time.Now()) }
							required
						/>
					</div>
				</div>
				<div class="grid gap-3" data-set-list>
					@exerciseSetRow(0, weightUnit)
				</div>
				<div>
					<button
						type="button"
						class="btn-outline btn-sm"
						data-add-set
					>
						@components.Icon(components.IconProps{Name: "plus", Size: 14})
						Add Set
					</button>
				</div>
				<div class="grid gap-2">
					<label for="notes">Notes (optional)</label>
					<textarea
						id="notes"
						name="notes"
						class="textarea"
						placeholder="How did it feel? Any observations?"
					></textarea>
				</div>
			</fieldset>
			<div class="flex gap-3">
				<button type="submit" hx-indicator="#exercise-entry-spinner" class="btn relative inline-flex">
					<span class="btn-text flex items-center justify-around gap-2">
						@components.Icon(components.IconProps{Name: "check", Size: 18})
						Save
					</span>
					<span id="exercise-entry-spinner" class="htmx-indicator absolute inset-0 flex items-center justify-center animate-spin">
						@components.Icon(components.IconProps{Name: "loader", Size: 18})
					</span>
				</button>
				<a href="/" class="btn-outline">
					@components.Icon(components.IconProps{Name: "x", Size: 18})
					Cancel
				</a>
			</div>
		</form>
		// Hidden template used by the inline script to clone new rows. Kept
		// outside the visible form flow so it doesn't render as a row itself.
		<template id="exercise-entry-set-template">
			@exerciseSetRowPlaceholder()
		</template>
		@exerciseEntryFormSetScript()
	}
}

// EditExerciseEntryForm renders the form for editing an existing exercise entry.
// weightUnit is the user's preferred unit and drives the weight input label.
templ EditExerciseEntryForm(exerciseEntry *models.ExerciseEntry, userName string, isAuthenticated bool, isAdmin bool, weightUnit string) {
	@views.Layout(views.PageData{Title: "Edit Set", UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin}) {
		<div class="w-full flex items-center justify-between">
			@components.Title(components.TitleProps{Size: "lg", Color: "default", Title: "Edit Set"})
			<button
				type="button"
				class="btn-sm-icon-destructive relative inline-flex"
				hx-delete={ fmt.Sprintf("/exercise-entries/%s", exerciseEntry.ID) }
				hx-confirm="Are you sure you want to delete this set?"
				hx-target="#toaster"
				hx-swap="beforeend"
				hx-indicator="#delete-spinner"
			>
				<span class="flex items-center justify-around gap-2">
					@components.Icon(components.IconProps{Name: "trash", Size: 14})
				</span>
				<span id="delete-spinner" class="htmx-indicator absolute inset-0 flex items-center justify-center animate-spin">
					@components.Icon(components.IconProps{Name: "loader", Size: 14})
				</span>
			</button>
		</div>
		<form
			id="exercise-entry-form"
			hx-put={ fmt.Sprintf("/exercise-entries/%s", exerciseEntry.ID) }
			hx-target="#toaster"
			hx-swap="beforeend"
			class="form grid gap-6"
		>
			<fieldset class="grid gap-4">
				<input type="hidden" name="exercise_id" value={ exerciseEntry.ExerciseID }/>
				<div class="grid gap-2">
					<label for="exercise-name">Exercise</label>
					<input
						type="text"
						id="exercise-name"
						name="exercise_name"
						class="input"
						value={ exerciseEntry.ExerciseName }
						disabled
					/>
				</div>
				<div class="grid grid-col-1 sm:grid-cols-3 gap-4">
					<div class="grid gap-2">
						<label for="reps">Reps</label>
						<input
							class="input"
							type="number"
							inputmode="numeric"
							id="reps"
							name="reps"
							min="1"
							value={ fmt.Sprintf("%d", exerciseEntry.Reps) }
							placeholder="8"
							required
						/>
					</div>
					<div class="grid gap-2">
						<label for="weight">Weight ({ weightUnit })</label>
						<input
							class="input"
							type="number"
							inputmode="decimal"
							id="weight"
							name="weight"
							step="0.5"
							min="0"
							value={ fmt.Sprintf("%.1f", exerciseEntry.Weight) }
							placeholder="0.0"
							required
						/>
					</div>
					<div class="grid gap-2">
						<label for="rest_time">Rest time (seconds)</label>
						<input
							class="input"
							type="number"
							inputmode="numeric"
							id="rest_time"
							name="rest_time"
							min="0"
							max="3600"
							value={ fmt.Sprintf("%d", exerciseEntry.RestTime) }
							placeholder="0"
						/>
					</div>
				</div>
				<div class="grid gap-2">
					<label for="date">Date & Time</label>
					<input
						class="input"
						type="datetime-local"
						id="date"
						name="created_at"
						value={ views.FormatDateTimeLocal(exerciseEntry.CreatedAt) }
						required
					/>
				</div>
				<div class="grid gap-2">
					<label for="notes">Notes (optional)</label>
					<textarea
						id="notes"
						name="notes"
						class="textarea"
						placeholder="How did it feel? Any observations?"
					>{ exerciseEntry.Notes }</textarea>
				</div>
				<input type="hidden" name="id" value={ fmt.Sprintf("%s", exerciseEntry.ID) }/>
			</fieldset>
			<div class="flex gap-3">
				<button type="submit" hx-indicator="#exercise-entry-spinner" class="btn relative inline-flex">
					<span class="btn-text flex items-center justify-around gap-2">
						@components.Icon(components.IconProps{Name: "check", Size: 18})
						Update Set
					</span>
					<span id="exercise-entry-spinner" class="htmx-indicator absolute inset-0 flex items-center justify-center animate-spin">
						@components.Icon(components.IconProps{Name: "loader", Size: 18})
					</span>
				</button>
				<a href="/" class="btn-outline">
					@components.Icon(components.IconProps{Name: "x", Size: 18})
					Cancel
				</a>
			</div>
		</form>
	}
}

// ExerciseEntryFormSuccess is shown after successful form submission
templ ExerciseEntryFormSuccess(message string, stayOnPage bool) {
	@views.Toast("success", "Set saved!", message)
	if !stayOnPage {
		<div class="mt-6 flex flex-col gap-3 sm:flex-row">
			<a href="/" class="btn-outline">
				@components.Icon(components.IconProps{Name: "arrow-left", Size: 18})
				Back to Dashboard
			</a>
			<a href="/exercise-entries/new" class="btn">
				@components.Icon(components.IconProps{Name: "plus", Size: 18})
				Add Another
			</a>
		</div>
	}
}

// ExerciseEntryFormError shows form validation errors
templ ExerciseEntryFormError(message string) {
	@views.Toast("error", "Error", message)
}

// ExerciseEntryFormSuccessToast returns only the toast (for HTMX responses)
templ ExerciseEntryFormSuccessToast(message string) {
	@views.Toast("success", "Set saved!", message)
}
