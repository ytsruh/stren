package views

import "stren/internal/views/components"

templ TimerPage(data PageData) {
	@Layout(data) {
		<div class="flex flex-col items-center justify-center min-h-[50vh] gap-8">
			@components.Title(components.TitleProps{Size: "xl", Color: "default", Title: "Timer"})
			<div class="w-full max-w-md">
				<div id="timer-presets" class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
					<button type="button" class="btn text-center" onclick="startPresetTimer(30)">30s</button>
					<button type="button" class="btn text-center" onclick="startPresetTimer(60)">60s</button>
					<button type="button" class="btn text-center" onclick="startPresetTimer(90)">90s</button>
				</div>
				<div id="custom-duration-section" class="flex flex-col items-center gap-6">
					<label for="custom-duration" class="text-sm text-muted-foreground">Custom duration (seconds)</label>
					<input
						type="number"
						id="custom-duration"
						class="input w-32 text-center text-lg"
						min="1"
						max="300"
						placeholder="30"
					/>
					<button type="button" id="start-custom-btn" class="btn" onclick="startCustomTimer()">
						Start
					</button>
				</div>
				<div id="timer-display" class="flex-col items-center justify-center mt-8">
					<div class="text-8xl font-bold tabular-nums hidden" id="countdown-display">--:--</div>
					<div class="flex gap-4 mt-8">
						<button type="button" id="start-btn" class="btn hidden" onclick="startTimer()">Start</button>
						<button type="button" id="stop-btn" class="btn-outline hidden" onclick="stopTimer()">Stop</button>
						<button type="button" id="reset-btn" class="btn-outline hidden" onclick="resetTimer()">Reset</button>
					</div>
				</div>
				<div id="timer-complete" class="flex-col items-center gap-4 mt-8 hidden">
					<div class="text-4xl font-bold text-primary">Timer Complete!</div>
					<button type="button" class="btn-outline" onclick="resetTimer()">Start Another</button>
				</div>
			</div>
		</div>
		<script src="/js/timer.js"></script>
	}
}
