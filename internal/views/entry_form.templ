package views

import (
	"fmt"
	"stren/internal/models"
	"stren/internal/views/components"
	"time"
)

// entrySetRow renders a single set's input row inside the new-entry form. The
// index argument is interpolated into the bracket-notation field names
// (sets[N][reps], etc.) so the server-side parseEntrySets can group the values
// back into per-set structs. The remove button is wired up via data attributes
// — see entryFormSetScript for the add/remove logic.
//
// Layout: on mobile (<sm) the label and X button form a header row and the
// three inputs stack vertically beneath it as full-width fields. At sm: and
// above the header wrapper switches to display:contents (sm:contents) so its
// children join the parent grid as direct items, giving the original
// five-column row (label · reps · weight · rest · X).
templ entrySetRow(index int) {
	<div class="grid gap-3 sm:grid-cols-[auto_1fr_1fr_1fr_auto] sm:items-end sm:gap-3" data-set-row>
		<div class="flex items-center justify-between sm:contents">
			<div class="text-sm font-medium text-muted-foreground" data-set-label>
				{ fmt.Sprintf("Set %d", index+1) }
			</div>
			<button
				type="button"
				class="btn-sm-icon-outline sm:order-5"
				data-remove-set
				aria-label="Remove set"
				title="Remove set"
			>
				@components.Icon(components.IconProps{Name: "x", Size: 14})
			</button>
		</div>
		<div class="grid gap-2">
			<label class="text-sm">Reps</label>
			<input
				class="input"
				type="number"
				name={ fmt.Sprintf("sets[%d][reps]", index) }
				min="1"
				placeholder="8"
				required
			/>
		</div>
		<div class="grid gap-2">
			<label class="text-sm">Weight (kg)</label>
			<input
				class="input"
				type="number"
				name={ fmt.Sprintf("sets[%d][weight]", index) }
				step="0.5"
				min="0"
				placeholder="0.0"
				required
			/>
		</div>
		<div class="grid gap-2">
			<label class="text-sm">Rest (s)</label>
			<input
				class="input"
				type="number"
				name={ fmt.Sprintf("sets[%d][rest_time]", index) }
				min="0"
				max="3600"
				placeholder="0"
			/>
		</div>
	</div>
}

// entrySetRowPlaceholder is rendered only inside the <template> element that
// the inline script clones to add new rows. It uses the literal placeholder
// string __INDEX__ in field names; the script substitutes it for the next
// available index at clone time. Layout matches entrySetRow so cloned rows
// look identical to the starter rows.
templ entrySetRowPlaceholder() {
	<div class="grid gap-3 sm:grid-cols-[auto_1fr_1fr_1fr_auto] sm:items-end sm:gap-3" data-set-row>
		<div class="flex items-center justify-between sm:contents">
			<div class="text-sm font-medium text-muted-foreground" data-set-label>Set __INDEX__</div>
			<button type="button" class="btn-sm-icon-outline sm:order-5" data-remove-set aria-label="Remove set" title="Remove set">
				@components.Icon(components.IconProps{Name: "x", Size: 14})
			</button>
		</div>
		<div class="grid gap-2">
			<label class="text-sm">Reps</label>
			<input class="input" type="number" name="sets[__INDEX__][reps]" min="1" placeholder="8" required/>
		</div>
		<div class="grid gap-2">
			<label class="text-sm">Weight (kg)</label>
			<input class="input" type="number" name="sets[__INDEX__][weight]" step="0.5" min="0" placeholder="0.0" required/>
		</div>
		<div class="grid gap-2">
			<label class="text-sm">Rest (s)</label>
			<input class="input" type="number" name="sets[__INDEX__][rest_time]" min="0" max="3600" placeholder="0"/>
		</div>
	</div>
}

// entryFormSetScript is the small inline script that powers add/remove for
// the multi-set form. We use vanilla JS (no htmx round-trip) so adding or
// removing a row is instant. Indices are renumbered on every change so the
// server always sees a contiguous 0..N-1 sequence, matching the
// parseEntrySets grouping logic on the server. The max-set cap is read at
// runtime from the form's data-max-sets attribute so the server and client
// share a single source of truth (views.MaxSetsPerEntry).
//
// The clone template (#entry-set-template) lives at the top of the page
// outside the <form>, so it's looked up by ID via getElementById rather than
// form.querySelector. The Add handler is only bound when the template is
// found; the Remove handler is bound unconditionally so a missing template
// doesn't silently disable row removal.
templ entryFormSetScript() {
	<script>
		(function() {
			var form = document.getElementById('entry-form');
			if (!form) return;
			var MAX_SETS = parseInt(form.getAttribute('data-max-sets') || '10', 10);
			var list = form.querySelector('[data-set-list]');
			var addBtn = form.querySelector('[data-add-set]');
			if (!list || !addBtn) return;
			var tpl = document.getElementById('entry-set-template');

			function renumber() {
				var rows = list.querySelectorAll('[data-set-row]');
				rows.forEach(function(row, i) {
					row.querySelectorAll('[name]').forEach(function(input) {
						input.name = input.name.replace(/sets\[\d+\]/, 'sets[' + i + ']');
					});
					var label = row.querySelector('[data-set-label]');
					if (label) label.textContent = 'Set ' + (i + 1);
				});
				addBtn.disabled = rows.length >= MAX_SETS;
				addBtn.title = rows.length >= MAX_SETS
					? 'Maximum ' + MAX_SETS + ' sets per entry'
					: 'Add another set';
			}

			if (tpl) {
				addBtn.addEventListener('click', function() {
					if (list.querySelectorAll('[data-set-row]').length >= MAX_SETS) return;
					var idx = list.querySelectorAll('[data-set-row]').length;
					var clone = tpl.content.firstElementChild.cloneNode(true);
					clone.querySelectorAll('[name]').forEach(function(input) {
						input.name = input.name.replace(/__INDEX__/g, String(idx));
					});
					var label = clone.querySelector('[data-set-label]');
					if (label) label.textContent = 'Set ' + (idx + 1);
					list.appendChild(clone);
					renumber();
				});
			}

			list.addEventListener('click', function(ev) {
				var btn = ev.target.closest('[data-remove-set]');
				if (!btn) return;
				var row = btn.closest('[data-set-row]');
				if (!row) return;
				if (list.querySelectorAll('[data-set-row]').length <= 1) return;
				row.remove();
				renumber();
			});

			renumber();
		})();
	</script>
}

// EntryForm renders the form for creating a new entry.
// preselectedExerciseID, when non-empty, marks the matching <option> as selected.
templ EntryForm(exercises []models.Exercise, preselectedExerciseID string, userName string, isAuthenticated bool, isAdmin bool) {
	@Layout(PageData{Title: "New Entry", UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin}) {
		@components.Title(components.TitleProps{Size: "lg", Color: "default", Title: "New Entry"})
		<form
			id="entry-form"
			hx-post="/entries"
			hx-target="#toaster"
			hx-swap="beforeend"
			class="form grid gap-6"
			data-max-sets={ fmt.Sprintf("%d", MaxSetsPerEntry) }
		>
			<fieldset class="grid gap-4">
				// Exercise + date sit side-by-side at sm: and above, stack on
				// mobile. items-end aligns the input boxes at the bottom of
				// each column so the visually-aligned parts (the inputs)
				// match up regardless of label height.
				<div class="grid gap-4 sm:grid-cols-2 sm:items-end">
					<div class="grid gap-2">
						<label for="exercise-name">Exercise</label>
						<select
							id="exercise-name"
							name="exercise_id"
							class="select"
							required
						>
							<option value="">-- Select an exercise --</option>
							for _, e := range exercises {
								if e.ID == preselectedExerciseID {
									<option value={ e.ID } selected>{ e.Name }</option>
								} else {
									<option value={ e.ID }>{ e.Name }</option>
								}
							}
						</select>
					</div>
					<div class="grid gap-2">
						<label for="entry-date">Date & Time</label>
						<input
							class="input"
							type="datetime-local"
							id="entry-date"
							name="created_at"
							value={ FormatDateTimeLocal(time.Now()) }
							required
						/>
					</div>
				</div>
				<div class="grid gap-3" data-set-list>
					for i := 0; i < 3; i++ {
						@entrySetRow(i)
					}
				</div>
				<div>
					<button
						type="button"
						class="btn-outline btn-sm"
						data-add-set
					>
						@components.Icon(components.IconProps{Name: "plus", Size: 14})
						Add Set
					</button>
				</div>
				<div class="grid gap-2">
					<label for="notes">Notes (optional)</label>
					<textarea
						id="notes"
						name="notes"
						class="textarea"
						placeholder="How did it feel? Any observations?"
					></textarea>
				</div>
			</fieldset>
			<div class="flex gap-3">
				<button type="submit" hx-indicator="#entry-spinner" class="btn relative inline-flex">
					<span class="btn-text flex items-center justify-around gap-2">
						@components.Icon(components.IconProps{Name: "check", Size: 18})
						Save Entry
					</span>
					<span id="entry-spinner" class="htmx-indicator absolute inset-0 flex items-center justify-center animate-spin">
						@components.Icon(components.IconProps{Name: "loader", Size: 18})
					</span>
				</button>
				<a href="/" class="btn-outline">
					@components.Icon(components.IconProps{Name: "x", Size: 18})
					Cancel
				</a>
			</div>
		</form>
		// Hidden template used by the inline script to clone new rows. Kept
		// outside the visible form flow so it doesn't render as a row itself.
		<template id="entry-set-template">
			@entrySetRowPlaceholder()
		</template>
		@entryFormSetScript()
	}
}

// EditEntryForm renders the form for editing an existing entry
templ EditEntryForm(entry *models.ExerciseEntry, userName string, isAuthenticated bool, isAdmin bool) {
	@Layout(PageData{Title: "Edit Entry", UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin}) {
		<div class="w-full flex items-center justify-between">
			@components.Title(components.TitleProps{Size: "lg", Color: "default", Title: "Edit Entry"})
			<button
				type="button"
				class="btn-sm-icon-destructive relative inline-flex"
				hx-delete={ fmt.Sprintf("/entries/%s", entry.ID) }
				hx-confirm="Are you sure you want to delete this entry?"
				hx-target="#toaster"
				hx-swap="beforeend"
				hx-indicator="#delete-spinner"
			>
				<span class="flex items-center justify-around gap-2">
					@components.Icon(components.IconProps{Name: "trash", Size: 14})
				</span>
				<span id="delete-spinner" class="htmx-indicator absolute inset-0 flex items-center justify-center animate-spin">
					@components.Icon(components.IconProps{Name: "loader", Size: 14})
				</span>
			</button>
		</div>
		<form
			id="entry-form"
			hx-put={ fmt.Sprintf("/entries/%s", entry.ID) }
			hx-target="#toaster"
			hx-swap="beforeend"
			class="form grid gap-6"
		>
			<fieldset class="grid gap-4">
				<input type="hidden" name="exercise_id" value={ entry.ExerciseID }/>
				<div class="grid gap-2">
					<label for="exercise-name">Exercise</label>
					<input
						type="text"
						id="exercise-name"
						name="exercise_name"
						class="input"
						value={ entry.ExerciseName }
						disabled
					/>
				</div>
				<div class="grid grid-col-1 sm:grid-cols-3 gap-4">
					<div class="grid gap-2">
						<label for="reps">Reps</label>
						<input
							class="input"
							type="number"
							id="reps"
							name="reps"
							min="1"
							value={ fmt.Sprintf("%d", entry.Reps) }
							placeholder="8"
							required
						/>
					</div>
					<div class="grid gap-2">
						<label for="weight">Weight (kg)</label>
						<input
							class="input"
							type="number"
							id="weight"
							name="weight"
							step="0.5"
							min="0"
							value={ fmt.Sprintf("%.1f", entry.Weight) }
							placeholder="0.0"
							required
						/>
					</div>
					<div class="grid gap-2">
						<label for="rest_time">Rest time (seconds)</label>
						<input
							class="input"
							type="number"
							id="rest_time"
							name="rest_time"
							min="0"
							max="3600"
							value={ fmt.Sprintf("%d", entry.RestTime) }
							placeholder="0"
						/>
					</div>
				</div>
				<div class="grid gap-2">
					<label for="date">Date & Time</label>
					<input
						class="input"
						type="datetime-local"
						id="date"
						name="created_at"
						value={ FormatDateTimeLocal(entry.CreatedAt) }
						required
					/>
				</div>
				<div class="grid gap-2">
					<label for="notes">Notes (optional)</label>
					<textarea
						id="notes"
						name="notes"
						class="textarea"
						placeholder="How did it feel? Any observations?"
					>{ entry.Notes }</textarea>
				</div>
				<input type="hidden" name="id" value={ fmt.Sprintf("%s", entry.ID) }/>
			</fieldset>
			<div class="flex gap-3">
				<button type="submit" hx-indicator="#entry-spinner" class="btn relative inline-flex">
					<span class="btn-text flex items-center justify-around gap-2">
						@components.Icon(components.IconProps{Name: "check", Size: 18})
						Update Entry
					</span>
					<span id="entry-spinner" class="htmx-indicator absolute inset-0 flex items-center justify-center animate-spin">
						@components.Icon(components.IconProps{Name: "loader", Size: 18})
					</span>
				</button>
				<a href="/" class="btn-outline">
					@components.Icon(components.IconProps{Name: "x", Size: 18})
					Cancel
				</a>
			</div>
		</form>
	}
}

// EntryFormSuccess is shown after successful form submission
templ EntryFormSuccess(message string, stayOnPage bool) {
	@Toast("success", "Entry saved!", message)
	if !stayOnPage {
		<div class="mt-6 flex flex-col gap-3 sm:flex-row">
			<a href="/" class="btn-outline">
				@components.Icon(components.IconProps{Name: "arrow-left", Size: 18})
				Back to Dashboard
			</a>
			<a href="/entries/new" class="btn">
				@components.Icon(components.IconProps{Name: "plus", Size: 18})
				Add Another
			</a>
		</div>
	}
}

// EntryFormError shows form validation errors
templ EntryFormError(message string) {
	@Toast("error", "Error", message)
}

// EntryFormSuccessToast returns only the toast (for HTMX responses)
templ EntryFormSuccessToast(message string) {
	@Toast("success", "Entry saved!", message)
}

func FormatDateTimeLocal(t time.Time) string {
	return t.Format("2006-01-02T15:04")
}
