package views

import (
	"fmt"
	"stren/internal/models"
	"time"
)

// EntryForm renders the form for creating a new entry
templ EntryForm(types []models.ExerciseType, userName string, isAuthenticated bool) {
	@Layout(PageData{Title: "New Entry", UserName: userName, IsAuthenticated: isAuthenticated}) {
		<h1>New Entry</h1>
		
		<form 
			hx-post="/entries"
			hx-target="#form-result"
			hx-swap="innerHTML"
			class="mt-2">
			
			<fieldset>
				<label for="exercise-name">
					Exercise
					<select 
						id="exercise-name"
						name="exercise_name"
						required>
						<option value="">-- Select an exercise --</option>
						for _, t := range types {
							<option value={ t.Name }>{ t.Name }</option>
						}
					</select>
				</label>
				
				<div class="grid">
					<label for="reps">
						Reps
						<input
							type="number"
							id="reps"
							name="reps"
							min="1"
							placeholder="8"
							required/>
					</label>
					
					<label for="weight">
						Weight (kg)
						<input 
							type="number" 
							id="weight"
							name="weight"
							step="0.5"
							min="0"
							placeholder="0.0"
							required/>
					</label>
				</div>
				
				<label for="notes">
					Notes (optional)
					<textarea 
						id="notes"
						name="notes"
						placeholder="How did it feel? Any observations?"></textarea>
				</label>
			</fieldset>
			
			<div class="flex gap-1">
			<button type="submit" class="inline-flex items-center gap-1">
				@Icon(IconProps{Name: "check", Size: 18})
				Save Entry
			</button>
			<a href="/" role="button" class="secondary inline-flex items-center gap-1">@Icon(IconProps{Name: "x", Size: 18}) Cancel</a>
			</div>
		</form>
		
		<div id="form-result" class="mt-2"></div>
	}
}

// EditEntryForm renders the form for editing an existing entry
templ EditEntryForm(entry *models.ExerciseEntry, types []models.ExerciseType, userName string, isAuthenticated bool) {
	@Layout(PageData{Title: "Edit Entry", UserName: userName, IsAuthenticated: isAuthenticated}) {
		<h1>Edit Entry</h1>
		
		<form 
			hx-put={ fmt.Sprintf("/entries/%d", entry.ID) }
			hx-target="#form-result"
			hx-swap="innerHTML"
			class="mt-2">
			
			<fieldset>
				<label for="exercise-name">
					Exercise
					<select 
						id="exercise-name"
						name="exercise_name"
						required>
						for _, t := range types {
							<option 
								value={ t.Name }
								selected?={ t.Name == entry.ExerciseName }>
								{ t.Name }
							</option>
						}
					</select>
				</label>
				
				<div class="grid">
					<label for="reps">
						Reps
						<input
							type="number"
							id="reps"
							name="reps"
							min="1"
							value={ fmt.Sprintf("%d", entry.Reps) }
							placeholder="8"
							required/>
					</label>
					
					<label for="weight">
						Weight (kg)
						<input 
							type="number" 
							id="weight"
							name="weight"
							step="0.5"
							min="0"
							value={ fmt.Sprintf("%.1f", entry.Weight) }
							placeholder="0.0"
							required/>
					</label>
				</div>
				
				<label for="date">
					Date & Time
					<input 
						type="datetime-local" 
						id="date"
						name="created_at"
						value={ formatDateTimeLocal(entry.CreatedAt) }
						required/>
				</label>
				
				<label for="notes">
					Notes (optional)
					<textarea 
						id="notes"
						name="notes"
						placeholder="How did it feel? Any observations?">{ entry.Notes }</textarea>
				</label>
				
				<input type="hidden" name="id" value={ fmt.Sprintf("%d", entry.ID) }/>
			</fieldset>
			
			<div class="flex gap-1">
			<button type="submit" class="inline-flex items-center gap-1">
				@Icon(IconProps{Name: "check", Size: 18})
				Update Entry
			</button>
			<a href="/" role="button" class="secondary inline-flex items-center gap-1">@Icon(IconProps{Name: "x", Size: 18}) Cancel</a>
			</div>
		</form>
		
		<div id="form-result" class="mt-2"></div>
	}
}

// EntryFormSuccess is shown after successful form submission
templ EntryFormSuccess(message string, stayOnPage bool) {
	@Toast(message, false)
	
	if !stayOnPage {
		<div class="mt-2">
			<a href="/" role="button" class="flex items-center gap-1">@Icon(IconProps{Name: "arrow-left", Size: 18}) Back to Dashboard</a>
			<a href="/entries/new" role="button" class="secondary flex items-center gap-1">@Icon(IconProps{Name: "plus", Size: 18}) Add Another</a>
		</div>
	} else {
		<script>
			// Reset form after successful submission
			document.querySelector('form').reset();
			// Keep the exercise selection and clear reps for next set
			const exerciseSelect = document.getElementById('exercise-name');
			if (exerciseSelect) {
				const selectedExercise = exerciseSelect.value;
				document.querySelector('form').reset();
				exerciseSelect.value = selectedExercise;
			}
		</script>
	}
}

// EntryFormError shows form validation errors
templ EntryFormError(message string) {
	@Toast(message, true)
}

func formatDateTimeLocal(t time.Time) string {
	return t.Format("2006-01-02T15:04")
}
