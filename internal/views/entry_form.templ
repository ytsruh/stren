package views

import (
	"fmt"
	"stren/internal/models"
	"stren/internal/views/components"
	"time"
)

// EntryForm renders the form for creating a new entry
templ EntryForm(exercises []models.Exercise, userName string, isAuthenticated bool, isAdmin bool) {
	@Layout(PageData{Title: "New Entry", UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin}) {
		@components.Title(components.TitleProps{Size: "lg", Color: "default", Title: "New Entry"})
		<form
			id="entry-form"
			hx-post="/entries"
			hx-target="#toaster"
			hx-swap="beforeend"
			class="form grid gap-6"
		>
			<fieldset class="grid gap-4">
				<div class="grid gap-2">
					<label for="exercise-name">Exercise</label>
					<select
						id="exercise-name"
						name="exercise_id"
						class="select"
						required
					>
						<option value="">-- Select an exercise --</option>
						for _, e := range exercises {
							<option value={ e.ID }>{ e.Name }</option>
						}
					</select>
				</div>
				<div class="grid grid-col-1 sm:grid-cols-3 gap-4">
					<div class="grid gap-2">
						<label for="reps">Reps</label>
						<input
							class="input"
							type="number"
							id="reps"
							name="reps"
							min="1"
							placeholder="8"
							required
						/>
					</div>
					<div class="grid gap-2">
						<label for="weight">Weight (kg)</label>
						<input
							class="input"
							type="number"
							id="weight"
							name="weight"
							step="0.5"
							min="0"
							placeholder="0.0"
							required
						/>
					</div>
					<div class="grid gap-2">
						<label for="rest_time">Rest time (seconds)</label>
						<input
							class="input"
							type="number"
							id="rest_time"
							name="rest_time"
							min="0"
							max="3600"
							placeholder="0"
						/>
					</div>
				</div>
				<div class="grid gap-2">
					<label for="notes">Notes (optional)</label>
					<textarea
						id="notes"
						name="notes"
						class="textarea"
						placeholder="How did it feel? Any observations?"
					></textarea>
				</div>
			</fieldset>
			<div class="flex gap-3">
				<button type="submit" hx-indicator="#entry-spinner" class="btn relative inline-flex">
					<span class="btn-text flex items-center justify-around gap-2">
						@components.Icon(components.IconProps{Name: "check", Size: 18})
						Save Entry
					</span>
					<span id="entry-spinner" class="htmx-indicator absolute inset-0 flex items-center justify-center animate-spin">
						@components.Icon(components.IconProps{Name: "loader", Size: 18})
					</span>
				</button>
				<a href="/" class="btn-outline">
					@components.Icon(components.IconProps{Name: "x", Size: 18})
					Cancel
				</a>
			</div>
		</form>
	}
}

// EditEntryForm renders the form for editing an existing entry
templ EditEntryForm(entry *models.ExerciseEntry, userName string, isAuthenticated bool, isAdmin bool) {
	@Layout(PageData{Title: "Edit Entry", UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin}) {
		<div class="w-full flex items-center justify-between">
			@components.Title(components.TitleProps{Size: "lg", Color: "default", Title: "Edit Entry"})
			<button
				type="button"
				class="btn-sm-icon-destructive relative inline-flex"
				hx-delete={ fmt.Sprintf("/entries/%s", entry.ID) }
				hx-confirm="Are you sure you want to delete this entry?"
				hx-target="#toaster"
				hx-swap="beforeend"
				hx-indicator="#delete-spinner"
			>
				<span class="flex items-center justify-around gap-2">
					@components.Icon(components.IconProps{Name: "trash", Size: 14})
				</span>
				<span id="delete-spinner" class="htmx-indicator absolute inset-0 flex items-center justify-center animate-spin">
					@components.Icon(components.IconProps{Name: "loader", Size: 14})
				</span>
			</button>
		</div>
		<form
			id="entry-form"
			hx-put={ fmt.Sprintf("/entries/%s", entry.ID) }
			hx-target="#toaster"
			hx-swap="beforeend"
			class="form grid gap-6"
		>
			<fieldset class="grid gap-4">
				<input type="hidden" name="exercise_id" value={ entry.ExerciseID }/>
				<div class="grid gap-2">
					<label for="exercise-name">Exercise</label>
					<input
						type="text"
						id="exercise-name"
						name="exercise_name"
						class="input"
						value={ entry.ExerciseName }
						disabled
					/>
				</div>
				<div class="grid grid-col-1 sm:grid-cols-3 gap-4">
					<div class="grid gap-2">
						<label for="reps">Reps</label>
						<input
							class="input"
							type="number"
							id="reps"
							name="reps"
							min="1"
							value={ fmt.Sprintf("%d", entry.Reps) }
							placeholder="8"
							required
						/>
					</div>
					<div class="grid gap-2">
						<label for="weight">Weight (kg)</label>
						<input
							class="input"
							type="number"
							id="weight"
							name="weight"
							step="0.5"
							min="0"
							value={ fmt.Sprintf("%.1f", entry.Weight) }
							placeholder="0.0"
							required
						/>
					</div>
					<div class="grid gap-2">
						<label for="rest_time">Rest time (seconds)</label>
						<input
							class="input"
							type="number"
							id="rest_time"
							name="rest_time"
							min="0"
							max="3600"
							value={ fmt.Sprintf("%d", entry.RestTime) }
							placeholder="0"
						/>
					</div>
				</div>
				<div class="grid gap-2">
					<label for="date">Date & Time</label>
					<input
						class="input"
						type="datetime-local"
						id="date"
						name="created_at"
						value={ FormatDateTimeLocal(entry.CreatedAt) }
						required
					/>
				</div>
				<div class="grid gap-2">
					<label for="notes">Notes (optional)</label>
					<textarea
						id="notes"
						name="notes"
						class="textarea"
						placeholder="How did it feel? Any observations?"
					>{ entry.Notes }</textarea>
				</div>
				<input type="hidden" name="id" value={ fmt.Sprintf("%s", entry.ID) }/>
			</fieldset>
			<div class="flex gap-3">
				<button type="submit" hx-indicator="#entry-spinner" class="btn relative inline-flex">
					<span class="btn-text flex items-center justify-around gap-2">
						@components.Icon(components.IconProps{Name: "check", Size: 18})
						Update Entry
					</span>
					<span id="entry-spinner" class="htmx-indicator absolute inset-0 flex items-center justify-center animate-spin">
						@components.Icon(components.IconProps{Name: "loader", Size: 18})
					</span>
				</button>
				<a href="/" class="btn-outline">
					@components.Icon(components.IconProps{Name: "x", Size: 18})
					Cancel
				</a>
			</div>
		</form>
	}
}

// EntryFormSuccess is shown after successful form submission
templ EntryFormSuccess(message string, stayOnPage bool) {
	@Toast("success", "Entry saved!", message)
	if !stayOnPage {
		<div class="mt-6 flex flex-col gap-3 sm:flex-row">
			<a href="/" class="btn-outline">
				@components.Icon(components.IconProps{Name: "arrow-left", Size: 18})
				Back to Dashboard
			</a>
			<a href="/entries/new" class="btn">
				@components.Icon(components.IconProps{Name: "plus", Size: 18})
				Add Another
			</a>
		</div>
	}
}

// EntryFormError shows form validation errors
templ EntryFormError(message string) {
	@Toast("error", "Error", message)
}

// EntryFormSuccessToast returns only the toast (for HTMX responses)
templ EntryFormSuccessToast(message string) {
	@Toast("success", "Entry saved!", message)
}

func FormatDateTimeLocal(t time.Time) string {
	return t.Format("2006-01-02T15:04")
}
