package views

import "stren/internal/views/components"

templ EMOMPage(data PageData) {
	@Layout(data) {
		<div class="flex flex-col items-center justify-center min-h-[50vh] gap-8">
			@components.Title(components.TitleProps{Size: "xl", Color: "default", Title: "EMOM Timer"})
			<div class="w-full max-w-md">
				<div id="emom-presets" class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
					<button type="button" class="btn text-center" onclick="startPresetEMOM(5)">5 Rounds</button>
					<button type="button" class="btn text-center" onclick="startPresetEMOM(10)">10 Rounds</button>
					<button type="button" class="btn text-center" onclick="startPresetEMOM(15)">15 Rounds</button>
					<button type="button" class="btn text-center" onclick="startPresetEMOM(20)">20 Rounds</button>
				</div>
				<div id="custom-rounds-section" class="flex flex-col items-center gap-6">
					<label for="custom-rounds" class="text-sm text-muted-foreground">Custom rounds (max 15)</label>
					<input
						type="number"
						id="custom-rounds"
						class="input w-32 text-center text-lg"
						min="1"
						max="15"
						placeholder="10"
					/>
					<button type="button" id="start-custom-btn" class="btn" onclick="startCustomEMOM()">
						Start
					</button>
				</div>
				<div id="emom-display" class="flex-col items-center justify-center mt-8 hidden">
					<div class="text-4xl font-bold mb-4" id="round-display">Round 1/--</div>
					<div class="text-8xl font-bold tabular-nums" id="countdown-display">0:60</div>
					<div class="flex gap-4 mt-8">
						<button type="button" id="start-btn" class="btn hidden" onclick="startEMOM()">Start</button>
						<button type="button" id="stop-btn" class="btn-outline hidden" onclick="stopEMOM()">Stop</button>
						<button type="button" id="reset-btn" class="btn-outline hidden" onclick="resetEMOM()">Reset</button>
					</div>
				</div>
				<div id="emom-complete" class="flex-col items-center gap-4 mt-8 hidden">
					<div class="text-4xl font-bold text-primary">Complete!</div>
					<button type="button" class="btn-outline" onclick="resetEMOM()">Start Another</button>
				</div>
			</div>
		</div>
		<script src="/js/emom.js"></script>
	}
}
