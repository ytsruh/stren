package timers

import "stren/internal/views"

// TimersLayout renders the shared timers page chrome (title + basecoat tabs).
// The active tab is decided server-side via the active argument ("timer" or "emom").
// Each tab button navigates to its own route (/timer or /timer/emom) so that the
// full page is re-rendered with the matching panel.
templ TimersLayout(data views.PageData, active string) {
	@views.Layout(data) {
		<div class="flex flex-col items-center justify-center">
			<div class="tabs w-full" id="timers-tabs">
				<nav role="tablist" aria-orientation="horizontal" class="w-full">
					<button
						type="button"
						role="tab"
						id="timers-tab-timer"
						aria-controls="timers-panel-timer"
						aria-selected={ active == "timer" }
						tabindex="0"
						onclick="window.location.href='/timer'"
					>
						Timer
					</button>
					<button
						type="button"
						role="tab"
						id="timers-tab-emom"
						aria-controls="timers-panel-emom"
						aria-selected={ active == "emom" }
						tabindex="0"
						onclick="window.location.href='/timer/emom'"
					>
						EMOM
					</button>
				</nav>
				<div
					role="tabpanel"
					id="timers-panel-timer"
					aria-labelledby="timers-tab-timer"
					tabindex="-1"
					if active != "timer" {
						hidden
					}
				>
					if active == "timer" {
						<div class="flex justify-center items-center py-5">
							{ children... }
						</div>
					}
				</div>
				<div
					role="tabpanel"
					id="timers-panel-emom"
					aria-labelledby="timers-tab-emom"
					tabindex="-1"
					if active != "emom" {
						hidden
					}
				>
					if active == "emom" {
						<div class="flex justify-center items-center py-5">
							{ children... }
						</div>
					}
				</div>
			</div>
		</div>
	}
}
