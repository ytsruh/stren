package views

import (
	"fmt"
	"stren/internal/models"
	"stren/internal/views/components"
)

// WeightForm renders the form for creating a new weight entry
templ WeightForm(userName string, isAuthenticated bool, isAdmin bool) {
	@Layout(PageData{Title: "New Weight Entry", UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin}) {
		@components.Title(components.TitleProps{Size: "lg", Color: "default", Title: "New Weight Entry"})
		<form
			id="weight-form"
			hx-post="/weight"
			hx-target="#toaster"
			hx-swap="beforeend"
			class="form grid gap-6"
		>
			<fieldset class="grid gap-4">
				<div class="grid gap-2">
					<label for="weight">Weight (kg)</label>
					<input
						class="input"
						type="number"
						id="weight"
						name="weight"
						step="0.1"
						min="0"
						max="1000"
						placeholder="0.0"
						required
					/>
				</div>
				<div class="grid gap-2">
					<label for="notes">Notes (optional)</label>
					<textarea
						id="notes"
						name="notes"
						class="textarea"
						placeholder="Any observations about your weight today?"
					></textarea>
				</div>
				@components.PhotoUpload(components.PhotoUploadProps{
					Name:       "weight",
					Label:      "Photo (optional)",
					CurrentURL: "",
					CurrentKey: "",
					MaxSizeMB:  5,
				})
			</fieldset>
			<div class="flex gap-3">
				<button type="submit" hx-indicator="#weight-spinner" class="btn relative inline-flex">
					<span class="btn-text flex items-center justify-around gap-2">
						@components.Icon(components.IconProps{Name: "check", Size: 18})
						Save Weight
					</span>
					<span id="weight-spinner" class="htmx-indicator absolute inset-0 flex items-center justify-center animate-spin">
						@components.Icon(components.IconProps{Name: "loader", Size: 18})
					</span>
				</button>
				<a href="/weight" class="btn-outline">
					@components.Icon(components.IconProps{Name: "x", Size: 18})
					Cancel
				</a>
			</div>
		</form>
	}
}

// EditWeightForm renders the form for editing an existing weight entry
templ EditWeightForm(entry *models.WeightEntry, userName string, isAuthenticated bool, isAdmin bool) {
	@Layout(PageData{Title: "Edit Weight Entry", UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin}) {
		<div class="w-full flex items-center justify-between">
			@components.Title(components.TitleProps{Size: "lg", Color: "default", Title: "Edit Weight Entry"})
			<button
				type="button"
				class="btn-sm-icon-destructive relative inline-flex"
				hx-delete={ fmt.Sprintf("/weight/%s", entry.ID) }
				hx-confirm="Are you sure you want to delete this weight entry?"
				hx-target="#toaster"
				hx-swap="beforeend"
				hx-indicator="#delete-spinner"
			>
				<span class="flex items-center justify-around gap-2">
					@components.Icon(components.IconProps{Name: "trash", Size: 14})
				</span>
				<span id="delete-spinner" class="htmx-indicator absolute inset-0 flex items-center justify-center animate-spin">
					@components.Icon(components.IconProps{Name: "loader", Size: 14})
				</span>
			</button>
		</div>
		<form
			id="weight-form"
			hx-put={ fmt.Sprintf("/weight/%s", entry.ID) }
			hx-target="#toaster"
			hx-swap="beforeend"
			class="form grid gap-6"
		>
			<fieldset class="grid gap-4">
				<div class="grid gap-2">
					<label for="weight">Weight (kg)</label>
					<input
						class="input"
						type="number"
						id="weight"
						name="weight"
						step="0.1"
						min="0"
						max="1000"
						value={ fmt.Sprintf("%.1f", entry.Weight) }
						placeholder="0.0"
						required
					/>
				</div>
				<div class="grid gap-2">
					<label for="date">Date & Time</label>
					<input
						class="input"
						type="datetime-local"
						id="date"
						name="created_at"
						value={ FormatDateTimeLocal(entry.CreatedAt) }
						required
					/>
				</div>
				<div class="grid gap-2">
					<label for="notes">Notes (optional)</label>
					<textarea
						id="notes"
						name="notes"
						class="textarea"
						placeholder="Any observations about your weight today?"
					>{ entry.Notes }</textarea>
				</div>
				@components.PhotoUpload(components.PhotoUploadProps{
					Name:       "weight",
					Label:      "Photo (optional)",
					CurrentURL: entry.PhotoURL(),
					CurrentKey: entry.PhotoKey,
					MaxSizeMB:  5,
				})
				<input type="hidden" name="id" value={ fmt.Sprintf("%s", entry.ID) }/>
			</fieldset>
			<div class="flex gap-3">
				<button type="submit" hx-indicator="#weight-spinner" class="btn relative inline-flex">
					<span class="btn-text flex items-center justify-around gap-2">
						@components.Icon(components.IconProps{Name: "check", Size: 18})
						Update Weight
					</span>
					<span id="weight-spinner" class="htmx-indicator absolute inset-0 flex items-center justify-center animate-spin">
						@components.Icon(components.IconProps{Name: "loader", Size: 18})
					</span>
				</button>
				<a href="/weight" class="btn-outline">
					@components.Icon(components.IconProps{Name: "x", Size: 18})
					Cancel
				</a>
			</div>
		</form>
	}
}

// WeightFormSuccess is shown after successful form submission
templ WeightFormSuccess(message string, stayOnPage bool) {
	@Toast("success", "Weight saved!", message)
	if !stayOnPage {
		<div class="mt-6 flex flex-col gap-3 sm:flex-row">
			<a href="/weight" class="btn-outline">
				@components.Icon(components.IconProps{Name: "arrow-left", Size: 18})
				Back to Weight
			</a>
			<a href="/weight/new" class="btn">
				@components.Icon(components.IconProps{Name: "plus", Size: 18})
				Log Another
			</a>
		</div>
	}
}

// WeightFormError shows form validation errors
templ WeightFormError(message string) {
	@Toast("error", "Error", message)
}

// WeightFormSuccessToast returns only the toast (for HTMX responses)
templ WeightFormSuccessToast(message string) {
	@Toast("success", "Weight entry updated!", message)
}

// WeightDeleteSuccess returns the toast for successful deletion (for HTMX responses)
templ WeightDeleteSuccess() {
	@Toast("success", "Weight entry deleted!", "")
}
