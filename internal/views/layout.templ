package views

import "stren/internal/models"
import "stren/internal/views/components"

type PageData struct {
	Title           string
	Entries         []models.ExerciseEntry
	Types           []models.ExerciseType
	Entry           *models.ExerciseEntry
	UserName        string
	IsAuthenticated bool
}

// Layout is the base layout for all pages
templ Layout(data PageData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="theme-color" content="#4a5568"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="default"/>
			<meta name="apple-mobile-web-app-title" content="Stren"/>
			<link rel="icon" type="image/png" href="/icons/favicon-96x96.png" sizes="96x96"/>
			<link rel="icon" type="image/svg+xml" href="/icons/favicon.svg"/>
			<link rel="shortcut icon" href="/favicon.ico"/>
			<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png"/>
			<link rel="manifest" href="/manifest.json"/>
			<title>{ data.Title } - Strength Tracker</title>
			<!-- Dark mode: Basecoat uses .dark class on <html> -->
			<script>
				(() => {
					try {
						const stored = localStorage.getItem('themeMode');
						if (stored ? stored === 'dark'
									: matchMedia('(prefers-color-scheme: dark)').matches) {
							document.documentElement.classList.add('dark');
						}
					} catch (_) {}

					const apply = dark => {
						document.documentElement.classList.toggle('dark', dark);
						try { localStorage.setItem('themeMode', dark ? 'dark' : 'light'); } catch (_) {}
					};

					document.addEventListener('basecoat:theme', (event) => {
						const mode = event.detail?.mode;
						apply(mode === 'dark' ? true
								: mode === 'light' ? false
								: !document.documentElement.classList.contains('dark'));
					});
				})();
			</script>
			<!-- App styles -->
			<link rel="stylesheet" href="/css/styles.css"/>
			<!-- htmx -->
			<script src="https://unpkg.com/htmx.org@1.9.12"></script>
			<!-- basecoat -->
			<script src="https://cdn.jsdelivr.net/npm/basecoat-css@0.3.11/dist/js/all.min.js" defer></script>
		</head>
		<body class="overflow-x-hidden">
			<header>
				<nav class="sticky top-0 z-50 flex items-center gap-4 px-4 bg-background border-b border-border shadow-sm">
					<ul class="flex list-none m-0 p-0 items-center gap-3">
						<li><strong>Stren</strong></li>
					</ul>
					<ul class="flex list-none m-0 p-0 items-center gap-3 ml-auto">
						if data.IsAuthenticated {
							<li>
								<a href="/" class="btn-ghost">
									@components.Icon(components.IconProps{Name: "home", Size: 18})
									<span class="hidden sm:inline">Dashboard</span>
								</a>
							</li>
							<li>
								<a href="/entries/new" class="btn-ghost">
									@components.Icon(components.IconProps{Name: "plus", Size: 18})
									<span class="hidden sm:inline">New Entry</span>
								</a>
							</li>
							<li>
								<div id="user-dropdown" class="dropdown-menu">
									<button type="button" id="user-dropdown-trigger" aria-haspopup="menu" aria-controls="user-dropdown-menu" aria-expanded="false" class="btn-ghost flex items-center gap-2 m-0">
										@components.Icon(components.IconProps{Name: "user", Size: 18})
										<span class="hidden sm:inline">{ data.UserName }</span>
										@components.Icon(components.IconProps{Name: "chevron-down", Size: 16})
									</button>
									<div id="user-dropdown-popover" data-popover aria-hidden="true" class="min-w-40">
										<div role="menu" id="user-dropdown-menu" aria-labelledby="user-dropdown-trigger">
											<a href="/profile" role="menuitem" class="block px-4 py-2 no-underline hover:bg-accent">Profile</a>
											<hr role="separator"/>
											<form method="POST" action="/logout">
												<button type="submit" role="menuitem" class="w-full text-left px-4 py-2 hover:bg-accent">Logout</button>
											</form>
										</div>
									</div>
								</div>
							</li>
						} else {
							<li>
								<a href="/login" class="btn-link">Login</a>
							</li>
							<li>
								<a href="/register" class="btn-link">Register</a>
							</li>
						}
					</ul>
				</nav>
			</header>
			<main class="container mx-auto max-w-3xl px-4 py-8 flex-1">
				{ children... }
			</main>
			<dialog id="confirm-dialog" class="dialog w-full sm:max-w-[425px]" onclick="if(event.target===this)this.close()">
				<form method="dialog">
					<header>
						<h3>Confirm</h3>
						<p id="confirm-message"></p>
					</header>
					<footer>
						<button type="button" commandfor="confirm-dialog" command="close" class="btn-outline">Cancel</button>
						<button type="button" id="confirm-ok" value="confirm" class="btn-destructive">Confirm</button>
					</footer>
				</form>
			</dialog>
			<script>
				document.body.addEventListener('htmx:confirm', function(evt) {
					if (!evt.target.hasAttribute('hx-confirm')) return;
					evt.preventDefault();
					var dialog = document.getElementById('confirm-dialog');
					document.getElementById('confirm-message').textContent = evt.detail.question;
					document.getElementById('confirm-ok').onclick = function() {
						dialog.close();
						evt.detail.issueRequest(true);
					};
					dialog.showModal();
				});
			</script>
			<script>
				if ('serviceWorker' in navigator) {
					navigator.serviceWorker.register('/sw.js').catch(function(err) {
						console.error('Service worker registration failed:', err);
					});
				}
			</script>
		</body>
	</html>
}

// Toast is a notification component
templ Toast(message string, isError bool) {
	if isError {
		<div class="alert-destructive" role="alert">
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>
			<h2>Error</h2>
			<section>{ message }</section>
		</div>
	} else {
		<div class="alert" role="alert">
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>
			<h2>Success</h2>
			<section>{ message }</section>
		</div>
	}
}

// EmptyState shows when no entries exist
templ EmptyState() {
	<div class="flex min-w-0 flex-1 flex-col items-center justify-center gap-6 rounded-lg border-dashed border-2 p-12 text-center">
		<header class="flex max-w-sm flex-col items-center gap-3 text-center">
			<div class="mb-4 bg-muted text-foreground flex size-12 shrink-0 items-center justify-center rounded-lg">
				@components.Icon(components.IconProps{Name: "dumbbell", Size: 24})
			</div>
			<h3 class="text-lg font-semibold">No workouts yet</h3>
			<p class="text-muted-foreground text-sm">Start tracking your strength journey by adding your first exercise entry.</p>
		</header>
		<section class="flex w-full max-w-sm min-w-0 flex-col items-center gap-3">
			<a href="/entries/new" class="btn">
				@components.Icon(components.IconProps{Name: "plus", Size: 18})
				Add First Entry
			</a>
		</section>
	</div>
}
