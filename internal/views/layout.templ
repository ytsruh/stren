package views

import "stren/internal/models"

type PageData struct {
	Title          string
	Entries        []models.ExerciseEntry
	Types          []models.ExerciseType
	Entry          *models.ExerciseEntry
	UserName       string
	IsAuthenticated bool
}

// Layout is the base layout for all pages
templ Layout(data PageData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="theme-color" content="#4a5568"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="default"/>
			<meta name="apple-mobile-web-app-title" content="Stren"/>
			<link rel="icon" type="image/png" href="/icons/favicon-96x96.png" sizes="96x96"/>
			<link rel="icon" type="image/svg+xml" href="/icons/favicon.svg"/>
			<link rel="shortcut icon" href="/favicon.ico"/>
			<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png"/>
			<link rel="manifest" href="/manifest.json"/>
			<title>{ data.Title } - Strength Tracker</title>
			<!-- Oat CSS -->
			<link rel="stylesheet" href="https://unpkg.com/@knadh/oat/oat.min.css"/>
			<script src="https://unpkg.com/@knadh/oat/oat.min.js" defer></script>
			<!-- App styles -->
			<link rel="stylesheet" href="/css/styles.css"/>
			<!-- htmx -->
			<script src="https://unpkg.com/htmx.org@1.9.12"></script>
		</head>
		<body>
			<header>
				<nav data-topnav>
					<ul>
						<li><strong>Stren</strong></li>
					</ul>
					<ul>
						if data.IsAuthenticated {
							<li>
								<a href="/" class="flex items-center gap-1">
									@Icon(IconProps{Name: "home", Size: 18})
									Dashboard
								</a>
							</li>
							<li>
								<a href="/entries/new" class="flex items-center gap-1">
									@Icon(IconProps{Name: "plus", Size: 18})
									New Entry
								</a>
							</li>
							<li>
								<form method="POST" action="/logout" style="display: inline;">
									<button type="submit" class="outline" style="margin: 0;">
										@Icon(IconProps{Name: "log-out", Size: 18})
										{ data.UserName }
									</button>
								</form>
							</li>
						} else {
							<li>
								<a href="/login">Login</a>
							</li>
							<li>
								<a href="/register" role="button">Register</a>
							</li>
						}
					</ul>
				</nav>
			</header>
			<main class="container">
				{ children... }
			</main>
			<dialog id="confirm-dialog" closedby="any">
				<form method="dialog">
					<header>
						<h3>Confirm</h3>
						<p id="confirm-message"></p>
					</header>
					<footer>
						<button type="button" commandfor="confirm-dialog" command="close" class="outline">Cancel</button>
						<button type="button" id="confirm-ok" value="confirm" data-variant="danger">Confirm</button>
					</footer>
				</form>
			</dialog>
			<script>
				document.body.addEventListener('htmx:confirm', function(evt) {
					if (!evt.target.hasAttribute('hx-confirm')) return;
					evt.preventDefault();
					var dialog = document.getElementById('confirm-dialog');
					document.getElementById('confirm-message').textContent = evt.detail.question;
					document.getElementById('confirm-ok').onclick = function() {
						dialog.close();
						evt.detail.issueRequest(true);
					};
					dialog.showModal();
				});
			</script>
			<script>
				if ('serviceWorker' in navigator) {
					navigator.serviceWorker.register('/sw.js').catch(function(err) {
						console.error('Service worker registration failed:', err);
					});
				}
			</script>
		</body>
	</html>
}

// Toast is a notification component
templ Toast(message string, isError bool) {
	if isError {
		<article class="alert alert-danger" role="alert">
			{ message }
		</article>
	} else {
		<article class="alert alert-success" role="alert">
			{ message }
		</article>
	}
}

// EmptyState shows when no entries exist
templ EmptyState() {
	<article>
		<header>
			<h3>No workouts yet</h3>
		</header>
		<p>Start tracking your strength journey by adding your first exercise entry.</p>
		<footer>
			<a href="/entries/new" role="button" class="flex items-center gap-1">
				@Icon(IconProps{Name: "plus", Size: 18})
				Add First Entry
			</a>
		</footer>
	</article>
}
