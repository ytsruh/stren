package views

import "stren/internal/models"
import "stren/internal/views/components"

type PageData struct {
	Title           string
	Entries         []models.ExerciseEntry
	Exercises       []models.Exercise
	Entry           *models.ExerciseEntry
	UserName        string
	IsAuthenticated bool
	IsAdmin         bool
	CurrentPath     string
}

// Layout is the base layout for all pages
templ Layout(data PageData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<meta name="theme-color" content="#4a5568"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="default"/>
			<meta name="apple-mobile-web-app-title" content="Stren"/>
			<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png"/>
			<link rel="icon" type="image/png" href="/icons/favicon-96x96.png" sizes="96x96"/>
			<link rel="icon" type="image/svg+xml" href="/icons/favicon.svg"/>
			<link rel="shortcut icon" href="/favicon.ico"/>
			<link rel="manifest" href="/manifest.json"/>
			<title>{ data.Title } - Strength Tracker</title>
			<script>
				(() => {
					try {
						const stored = localStorage.getItem('themeMode');
						if (stored ? stored === 'dark'
									: matchMedia('(prefers-color-scheme: dark)').matches) {
							document.documentElement.classList.add('dark');
						}
					} catch (_) {}

					const apply = dark => {
						document.documentElement.classList.toggle('dark', dark);
						try { localStorage.setItem('themeMode', dark ? 'dark' : 'light'); } catch (_) {}
					};

					document.addEventListener('basecoat:theme', (event) => {
						const mode = event.detail?.mode;
						apply(mode === 'dark' ? true
								: mode === 'light' ? false
								: !document.documentElement.classList.contains('dark'));
					});
				})();
			</script>
			<link rel="stylesheet" href="/css/styles.css"/>
			<link rel="stylesheet" href="https://unpkg.com/image-compare-viewer@1.6.2/dist/image-compare-viewer.min.css"/>
			<script src="https://unpkg.com/htmx.org@1.9.12"></script>
			<script src="https://unpkg.com/image-compare-viewer@1.6.2/dist/image-compare-viewer.min.js" defer></script>
			<script src="https://cdn.jsdelivr.net/npm/basecoat-css@0.3.11/dist/js/all.min.js" defer></script>
		</head>
		<body>
			if data.IsAuthenticated {
				<aside class="sidebar" data-side="left" aria-hidden="false">
					<nav aria-label="Sidebar navigation">
						<header class="border-sidebar-border">
							<div class="flex items-center px-2 gap-2">
								<div class="bg-primary text-primary-foreground flex size-8 shrink-0 items-center justify-center rounded-lg font-bold">S</div>
								<span class="font-semibold text-sidebar-foreground truncate">Stren</span>
							</div>
						</header>
						<section class="flex flex-col gap-y-5 py-5 pl-2 pr-3">
							<div>
								<h3>Exercise</h3>
								<ul>
									<li>
										<a
											href="/"
											if data.CurrentPath == "/" {
												aria-current="page"
											}
										>
											@components.Icon(components.IconProps{Name: "home", Size: 18})
											<span>Dashboard</span>
										</a>
									</li>
									<li>
										<a
											href="/entries/new"
											if data.CurrentPath == "/entries/new" {
												aria-current="page"
											}
										>
											@components.Icon(components.IconProps{Name: "plus", Size: 18})
											<span>New Entry</span>
										</a>
									</li>
									<li>
										<a
											href="/exercises"
											if data.CurrentPath == "/exercises" {
												aria-current="page"
											}
										>
											@components.Icon(components.IconProps{Name: "dumbbell", Size: 18})
											<span>Exercises</span>
										</a>
									</li>
									<li>
										<a
											href="/timer"
											if data.CurrentPath == "/timer" || data.CurrentPath == "/timer/emom" {
												aria-current="page"
											}
										>
											@components.Icon(components.IconProps{Name: "timer", Size: 18})
											<span>Timer</span>
										</a>
									</li>
								</ul>
							</div>
							<div>
								<h3>Tracking</h3>
								<ul>
									<li>
										<a
											href="/weight"
											if data.CurrentPath == "/weight" {
												aria-current="page"
											}
										>
											@components.Icon(components.IconProps{Name: "scale", Size: 18})
											<span>Weight</span>
										</a>
									</li>
								</ul>
							</div>
							if data.IsAdmin {
								<div>
									<h3>Admin</h3>
									<ul>
										<li>
											<a
												href="/admin/exercises"
												if data.CurrentPath == "/admin/exercises" {
													aria-current="page"
												}
											>
												@components.Icon(components.IconProps{Name: "dumbbell", Size: 18})
												<span>Exercises</span>
											</a>
										</li>
										<li>
											<a
												href="/admin/users"
												if data.CurrentPath == "/admin/users" {
													aria-current="page"
												}
											>
												@components.Icon(components.IconProps{Name: "user", Size: 18})
												<span>Users</span>
											</a>
										</li>
						<li>
							<a
								href="/admin/feedback"
								if data.CurrentPath == "/admin/feedback" {
									aria-current="page"
								}
							>
								@components.Icon(components.IconProps{Name: "message", Size: 18})
								<span>Feedback</span>
							</a>
						</li>
						<li>
							<a
								href="/admin/notifications"
								if data.CurrentPath == "/admin/notifications" {
									aria-current="page"
								}
							>
								@components.Icon(components.IconProps{Name: "bell", Size: 18})
								<span>Notifications</span>
							</a>
						</li>
					</ul>
				</div>
			}
							<div>
								<h3>Account</h3>
								<ul>
									<li>
										<a
											href="/profile"
											if data.CurrentPath == "/profile" {
												aria-current="page"
											}
										>
											@components.Icon(components.IconProps{Name: "user", Size: 18})
											<span>Profile</span>
										</a>
									</li>
									<li>
										<a
											href="/feedback"
											if data.CurrentPath == "/feedback" {
												aria-current="page"
											}
										>
											@components.Icon(components.IconProps{Name: "message", Size: 18})
											<span>Feedback</span>
										</a>
									</li>
									<li>
										<form
											hx-post="/logout"
											hx-target="#toaster"
											hx-swap="beforeend"
											hx-indicator="#logout-spinner"
										>
											<button type="submit" class="hover:cursor-pointer flex w-full items-center gap-2 overflow-hidden rounded-md p-2 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground active:bg-sidebar-accent active:text-sidebar-accent-foreground [&>svg]:size-4 [&>svg]:shrink-0">
												<span class="btn-text flex items-center gap-2">
													@components.Icon(components.IconProps{Name: "log-out", Size: 18})
													<span class="truncate">Logout</span>
												</span>
												<span id="logout-spinner" class="htmx-indicator flex items-center justify-center animate-spin">
													@components.Icon(components.IconProps{Name: "loader", Size: 18})
												</span>
											</button>
										</form>
									</li>
								</ul>
							</div>
						</section>
					</nav>
				</aside>
			}
			<main>
				<header>
					<nav class="sticky top-0 flex items-center gap-4 px-4 py-2 bg-background border-b">
						<ul class="w-full flex justify-between list-none m-0 p-0 items-center">
							if data.IsAuthenticated {
								<div class="flex items-center gap-1">
									<li>
										<button type="button" onclick="document.dispatchEvent(new CustomEvent('basecoat:sidebar'))" class="btn-ghost" aria-label="Toggle sidebar">
											@components.Icon(components.IconProps{Name: "menu", Size: 20})
										</button>
									</li>
									<a href="/"><li class="flex lg:hidden text-primary">Stren</li></a>
								</div>
								<div class="flex gap-1">
									<li>
										<a href="/entries/new" class="btn-ghost">
											@components.Icon(components.IconProps{Name: "plus", Size: 20})
										</a>
									</li>
								</div>
							} else {
								<div class="w-full flex items-center justify-between">
									<div class="flex items-center px-2 gap-2">
										<div class="bg-primary text-primary-foreground flex size-8 shrink-0 items-center justify-center rounded-lg font-bold">S</div>
										<span class="font-bold text-sidebar-foreground truncate">Stren</span>
									</div>
									<div class="flex gap-1">
										<a href="/login" class="btn-ghost">Login</a>
										<a href="/register" class="btn-ghost">Register</a>
									</div>
								</div>
							}
						</ul>
					</nav>
				</header>
				<div class="container mx-auto max-w-3xl px-4 py-4 md:py-8">
					{ children... }
				</div>
			</main>
		<dialog id="confirm-dialog" class="dialog w-full sm:max-w-[425px]" onclick="if(event.target===this)this.close()">
			<form method="dialog">
				<header>
					<h3>Confirm</h3>
					<p id="confirm-message"></p>
				</header>
				<footer class="flex items-center gap-3">
					<button type="button" commandfor="confirm-dialog" command="close" class="btn-outline">Cancel</button>
					{{/*
						The OK button defaults to `btn-destructive`
						because the dialog was originally built for
						"are you sure you want to delete …?"
						confirmations (the only htmx-confirm uses in
						the app today). Non-destructive callers
						(e.g. the weight export) swap the class to
						`btn` (or another non-destructive variant)
						right before showModal() and restore the
						original className on the dialog's `close`
						event — see WeightExportScript in
						internal/views/weight/list.templ for the
						canonical example.
					*/}}
					<button type="button" id="confirm-ok" value="confirm" hx-indicator="#confirm-spinner, self" class="btn-destructive relative inline-flex">
						<span class="btn-text">Confirm</span>
						<span id="confirm-spinner" class="htmx-indicator flex items-center justify-center animate-spin">
							@components.Icon(components.IconProps{Name: "loader", Size: 18})
						</span>
					</button>
				</footer>
			</form>
		</dialog>
			<script>
				document.body.addEventListener('htmx:confirm', function(evt) {
					if (!evt.target.hasAttribute('hx-confirm')) return;
					evt.preventDefault();
					var dialog = document.getElementById('confirm-dialog');
					document.getElementById('confirm-message').textContent = evt.detail.question;
					document.getElementById('confirm-ok').onclick = function() {
						evt.detail.issueRequest(true);
					};
					dialog.showModal();
				});
				document.body.addEventListener('htmx:afterRequest', function(evt) {
					var dialog = document.getElementById('confirm-dialog');
					if (dialog.open) {
						dialog.close();
					}
				});
				document.body.addEventListener('triggerRedirect', function(evt) {
					setTimeout(function() {
						window.location.href = evt.detail.value;
					}, 500);
				});
			</script>
		<script>
			if ('serviceWorker' in navigator) {
				navigator.serviceWorker.register('/sw.js').catch(function(err) {
					console.error('Service worker registration failed:', err);
				});
				// Page-side handler for the service worker's
				// push-navigate messages. The SW cannot navigate
				// an existing PWA client reliably on iOS
				// (client.navigate is a no-op there), so the SW
				// focuses the client and posts a message; this
				// listener does the actual window.location.href
				// change, which works on every platform.
				navigator.serviceWorker.addEventListener('message', function (event) {
					if (event.data && event.data.type === 'push-navigate' && typeof event.data.url === 'string') {
						window.location.href = event.data.url;
					}
				});
			}
		</script>
		<script src="/js/push.js" defer></script>
		<div id="toaster" class="toaster"></div>
		// Hidden toast templates. Widgets that need to render a
		// toast from client-side code (e.g. the weight photo
		// widget, which uploads directly to R2 via a presigned
		// URL and so can't piggy-back its toast onto the upload
		// response) clone the right template and fill in the
		// title/description. The exercise image widget uses the
		// server-rendered views.Toast directly via htmx and
		// doesn't need these. The icon SVGs are defined once
		// here so they don't get duplicated into client-side JS.
		@toastTemplate("success")
		@toastTemplate("error")
		@toastTemplate("warning")
		@toastTemplate("default")
		</body>
	</html>
}

// toastBody renders the shared inner markup of a toast: the icon
// for the category plus the title and optional description. Used by
// both the server-rendered Toast and the hidden toastTemplate
// elements so the markup lives in exactly one place.
//
// title and description are rendered into the <h2> and <p> only
// when non-empty; the data-toast-title / data-toast-description
// attributes are always present so client-side JS that clones the
// template can find the right elements and fill them in (or
// overwrite whatever's there).
templ toastBody(category string, title string, description string) {
	<div class="toast-content">
		if category == "success" {
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>
		} else if category == "error" {
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>
		} else if category == "warning" {
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>
		} else {
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="16" y2="12"></line><line x1="12" x2="12.01" y1="8" y2="8"></line></svg>
		}
		<section>
			if title != "" {
				<h2 data-toast-title>{ title }</h2>
			} else {
				<h2 data-toast-title></h2>
			}
			if description != "" {
				<p data-toast-description>{ description }</p>
			} else {
				<p data-toast-description class="hidden"></p>
			}
		</section>
	</div>
}

// toastTemplate renders a hidden <template> element for one toast
// category. The category name becomes the id suffix and the
// data-category attribute. JS clones template.content, fills in
// the title/description, and appends the clone to #toaster.
templ toastTemplate(category string) {
	<template id={ "toast-template-" + category }>
		<div class="toast" role="status" aria-atomic="true" aria-hidden="false" data-category={ category }>
			@toastBody(category, "", "")
		</div>
	</template>
}

// Toast is a notification component using Basecoat toast
templ Toast(category string, title string, description string) {
	<div class="toast" role="status" aria-atomic="true" aria-hidden="false" data-category={ category }>
		@toastBody(category, title, description)
	</div>
}

// EmptyState shows when no entries exist
templ EmptyState() {
	<div class="flex min-w-0 flex-1 flex-col items-center justify-center gap-6 rounded-lg border-dashed border-2 p-12 text-center">
		<header class="flex max-w-sm flex-col items-center gap-3 text-center">
			<div class="mb-4 bg-muted text-foreground flex size-12 shrink-0 items-center justify-center rounded-lg">
				@components.Icon(components.IconProps{Name: "dumbbell", Size: 24})
			</div>
			<h3 class="text-lg font-semibold">No workouts in the last 7 days</h3>
			<p class="text-muted-foreground text-sm">Log a session to keep your streak going.</p>
		</header>
		<section class="flex w-full max-w-sm min-w-0 flex-col items-center gap-3">
			<a href="/entries/new" class="btn">
				@components.Icon(components.IconProps{Name: "plus", Size: 18})
				Add Entry
			</a>
		</section>
	</div>
}
