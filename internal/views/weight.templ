package views

import (
	"fmt"
	"math"
	"sort"
	"stren/internal/models"
	"stren/internal/views/components"
)

// WeightPage renders the weight entries list page. targetWeight is the
// user's body-weight goal; when non-nil, a progress widget is rendered
// alongside the chart.
templ WeightPage(entries []models.WeightEntry, userName string, isAuthenticated bool, isAdmin bool, targetWeight *float64) {
	@Layout(PageData{Title: "Weight", UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin}) {
		<div class="flex justify-between items-center mb-6">
			@components.Title(components.TitleProps{Size: "lg", Color: "default", Title: "Body Weight"})
			<a href="/weight/new" class="btn">
				@components.Icon(components.IconProps{Name: "plus", Size: 18})
				Log Weight
			</a>
		</div>
		<div class="flex flex-col sm:flex-row gap-4">
			<div
				class={ templ.Classes(
				"w-full",
				"h-32 sm:h-40",
				"card p-2",
				map[string]bool{"sm:w-3/4": targetWeight != nil && len(entries) > 0},
			) }
			>
				@components.Chart(chartDataForWeight(entries))
			</div>
			if targetWeight != nil && len(entries) > 0 {
				<div class="w-full sm:w-1/4 sm:h-40">
					@WeightProgressCard(entries, *targetWeight)
				</div>
			}
		</div>
		if len(entries) == 0 {
			@WeightEmptyState()
		} else {
			@WeightList(entries)
		}
	}
}

// chartDataForWeight converts a list of weight entries into the generic Chart
// props expected by components.Chart. Entries are sorted ascending by date so
// the line runs left-to-right. Labels are short dates ("10 Jun"). A second
// dataset containing a least-squares regression line is appended so the
// user can see the overall trend at a glance. The trendline is rendered
// dashed and hidden from the legend via opt-in flags on ChartDataset. The
// chart renders nothing when fewer than 2 entries are provided (handled
// inside Chart).
func chartDataForWeight(entries []models.WeightEntry) components.ChartProps {
	sorted := make([]models.WeightEntry, len(entries))
	copy(sorted, entries)
	sort.Slice(sorted, func(i, j int) bool {
		return sorted[i].CreatedAt.Before(sorted[j].CreatedAt)
	})
	labels := make([]string, len(sorted))
	values := make([]float64, len(sorted))
	for i, e := range sorted {
		labels[i] = e.CreatedAt.Format("02 Jan")
		values[i] = e.Weight
	}
	datasets := []components.ChartDataset{
		{Label: "Weight (kg)", Values: values},
	}
	if len(values) >= 2 {
		datasets = append(datasets, components.ChartDataset{
			Label:          "Trend",
			Values:         components.LinearRegression(values),
			Dashed:         true,
			HiddenInLegend: true,
		})
	}
	return components.ChartProps{
		ID:       "weight-chart",
		Title:    "",
		Labels:   labels,
		Datasets: datasets,
	}
}

// WeightList renders a table of weight entries
templ WeightList(entries []models.WeightEntry) {
	<table class="table w-full">
		<thead>
			<tr>
				<th>Date</th>
				<th>Weight</th>
				<th class="hidden lg:table-cell">Photo</th>
				<th class="hidden lg:table-cell">Notes</th>
				<th></th>
			</tr>
		</thead>
		<tbody id="weight-table">
			for _, entry := range entries {
				@WeightRow(entry)
			}
		</tbody>
	</table>
}

// WeightRow renders a single weight entry row
templ WeightRow(entry models.WeightEntry) {
	<tr id={ fmt.Sprintf("weight-%s", entry.ID) }>
		<td>{ entry.FormattedDate() }</td>
		<td>{ entry.FormattedWeight() }</td>
		<td class="hidden lg:table-cell">
			if entry.HasPhoto() {
				<img
					src={ templ.SafeURL(entry.PhotoURL()) }
					alt="Weight photo"
					class="size-12 rounded object-cover border"
				/>
			}
		</td>
		<td class="hidden lg:table-cell">{ entry.Notes }</td>
		<td>
			<div class="flex gap-2">
				<a
					href={ templ.SafeURL(fmt.Sprintf("/weight/%s/edit", entry.ID)) }
					class="btn-outline p-2"
					title="Edit"
				>
					@components.Icon(components.IconProps{Name: "edit", Size: 16})
				</a>
			</div>
		</td>
	</tr>
}

// WeightEmptyState shows when no weight entries exist
templ WeightEmptyState() {
	<div class="flex min-w-0 flex-1 flex-col items-center justify-center gap-6 rounded-lg border-dashed border-2 p-12 text-center">
		<header class="flex max-w-sm flex-col items-center gap-3 text-center">
			<div class="mb-4 bg-muted text-foreground flex size-12 shrink-0 items-center justify-center rounded-lg">
				@components.Icon(components.IconProps{Name: "scale", Size: 24})
			</div>
			<h3 class="text-lg font-semibold">No weight entries yet</h3>
			<p class="text-muted-foreground text-sm">Start tracking your body weight by logging your first entry.</p>
		</header>
		<section class="flex w-full max-w-sm min-w-0 flex-col items-center gap-3">
			<a href="/weight/new" class="btn">
				@components.Icon(components.IconProps{Name: "plus", Size: 18})
				Log Your First Weight
			</a>
		</section>
	</div>
}

// WeightProgressCard renders a small card summarising progress towards the
// user's body-weight goal. entries must be non-empty; the caller is
// responsible for not invoking this with a nil/empty slice — the chart row
// guards that with `len(entries) > 0`. The card is hidden by the caller
// when targetWeight is nil.
templ WeightProgressCard(entries []models.WeightEntry, target float64) {
	{{
		// Sort ascending by date so the first/last weight reads as
		// "the user's starting point" and "their latest reading".
		sorted := make([]models.WeightEntry, len(entries))
		copy(sorted, entries)
		sort.Slice(sorted, func(i, j int) bool {
			return sorted[i].CreatedAt.Before(sorted[j].CreatedAt)
		})
		start := sorted[0].Weight
		current := sorted[len(sorted)-1].Weight
		pct, label := weightProgress(start, current, target)
	}}
	<div class="card p-4 h-full flex flex-col gap-3 justify-center">
		<div>
			<p class="text-sm text-muted-foreground">Goal progress</p>
			<p class="text-2xl font-semibold">{ fmt.Sprintf("%.0f%%", pct) }</p>
		</div>
		<div
			class="h-2 w-full rounded-full bg-muted overflow-hidden"
			role="progressbar"
			aria-valuenow={ fmt.Sprintf("%.0f", pct) }
			aria-valuemin="0"
			aria-valuemax="100"
			aria-label={ label }
		>
			<div
				class="h-full bg-primary"
				style={ fmt.Sprintf("width: %.0f%%", pct) }
			></div>
		</div>
		<p class="text-xs text-muted-foreground">
			{ label }
		</p>
		<dl class="grid grid-cols-3 gap-2 text-xs mt-1">
			<div>
				<dt class="text-muted-foreground">Start</dt>
				<dd class="font-medium">{ fmt.Sprintf("%.1f kg", start) }</dd>
			</div>
			<div>
				<dt class="text-muted-foreground">Current</dt>
				<dd class="font-medium">{ fmt.Sprintf("%.1f kg", current) }</dd>
			</div>
			<div>
				<dt class="text-muted-foreground">Target</dt>
				<dd class="font-medium">{ fmt.Sprintf("%.1f kg", target) }</dd>
			</div>
		</dl>
	</div>
}

// weightProgress returns the percent progress (clamped to [0, 100]) and a
// short human-readable summary line for the WeightProgressCard.
//
// The percent is the simplest possible: current as a percentage of target.
//   - 67.6 / 70 * 100 = 96.6%
//   - 90 / 80 * 100   = 112.5% → clamped to 100% (overshot)
//   - 100 / 80 * 100  = 125%   → clamped to 100% (well over target)
//
// The label reports the distance from current to target. When current
// is within 0.05 kg of the target, "Goal reached" is shown instead.
func weightProgress(start, current, target float64) (float64, string) {
	if target == 0 {
		return 0, "Set a new target weight to see progress."
	}
	pct := current / target * 100
	if pct < 0 {
		pct = 0
	}
	if pct > 100 {
		pct = 100
	}
	remaining := math.Abs(target - current)
	if remaining < 0.05 {
		return pct, "Goal reached — keep it up!"
	}
	return pct, fmt.Sprintf("%.1f kg to go", remaining)
}
