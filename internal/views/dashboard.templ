package views

import (
	"fmt"
	"stren/internal/models"
	"time"
)

// Dashboard renders the main dashboard page
templ Dashboard(entries []models.ExerciseEntry, userName string, isAuthenticated bool) {
	@Layout(PageData{Title: "Dashboard", UserName: userName, IsAuthenticated: isAuthenticated}) {
		<div class="flex justify-between items-center mb-2">
			<h1>Workout History</h1>
			<a href="/entries/new" role="button" class="flex items-center gap-1">
				@Icon(IconProps{Name: "plus", Size: 18})
				New Entry
			</a>
		</div>
		if len(entries) == 0 {
			@EmptyState()
		} else {
			@EntryList(entries)
		}
	}
}

// EntryList renders a table of entries
templ EntryList(entries []models.ExerciseEntry) {
	<table>
		<thead>
			<tr>
				<th>Date</th>
				<th>Exercise</th>
				<th>Reps</th>
				<th>Weight</th>
				<th>Notes</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody id="entries-table">
			for _, entry := range entries {
				@EntryRow(entry)
			}
		</tbody>
	</table>
}

// EntryRow renders a single entry row (used for htmx swaps)
templ EntryRow(entry models.ExerciseEntry) {
	<tr id={ fmt.Sprintf("entry-%d", entry.ID) }>
		<td>{ entry.FormattedDate() }</td>
		<td>
			<a href={ templ.SafeURL(fmt.Sprintf("/exercises/%s", entry.ExerciseName)) }>
				{ entry.ExerciseName }
			</a>
		</td>
		<td>{ fmt.Sprintf("%d", entry.Reps) }</td>
		<td>{ entry.FormattedWeight() }</td>
		<td>{ entry.Notes }</td>
		<td>
			<div class="flex gap-1">
				<a
					href={ templ.SafeURL(fmt.Sprintf("/entries/%d/edit", entry.ID)) }
					class="button"
					role="button"
					title="Edit"
				>
					@Icon(IconProps{Name: "edit", Size: 16})
				</a>
				<button
					data-variant="danger"
					hx-delete={ fmt.Sprintf("/entries/%d", entry.ID) }
					hx-confirm="Are you sure you want to delete this entry?"
					hx-target={ fmt.Sprintf("#entry-%d", entry.ID) }
					hx-swap="outerHTML swap:0.3s"
				>
					@Icon(IconProps{Name: "trash", Size: 16})
				</button>
			</div>
		</td>
	</tr>
}

// DeletedRow is returned after deleting an entry (htmx swap)
templ DeletedRow() {
	<tr class="fade-out" style="display: none;"></tr>
}

// RecentEntries shows the most recent entries on the dashboard
templ RecentEntries(entries []models.ExerciseEntry) {
	<section>
		<h2>Recent Workouts</h2>
		if len(entries) == 0 {
			@EmptyState()
		} else {
			@EntryList(entries)
		}
	</section>
}

// QuickStats shows some basic statistics
templ QuickStats(entries []models.ExerciseEntry) {
	<section class="mt-2">
		<h3 class="flex items-center gap-1">
			@Icon(IconProps{Name: "calendar", Size: 20})
			Last 7 Days
		</h3>
		<div class="grid">
			@StatCard("Total Sets", fmt.Sprintf("%d", len(entries)))
			@StatCard("Unique Exercises", fmt.Sprintf("%d", countUniqueExercises(entries)))
			@StatCard("Total Volume", fmt.Sprintf("%.0f kg", calculateVolume(entries)))
		</div>
	</section>
}

// StatCard is a single statistic card
templ StatCard(label string, value string) {
	<article class="card">
		<header>
			<h4>{ value }</h4>
		</header>
		<p>{ label }</p>
	</article>
}

// Helper functions
func countUniqueExercises(entries []models.ExerciseEntry) int {
	seen := make(map[string]bool)
	sevenDaysAgo := time.Now().AddDate(0, 0, -7)
	for _, e := range entries {
		if e.CreatedAt.After(sevenDaysAgo) {
			seen[e.ExerciseName] = true
		}
	}
	return len(seen)
}

func calculateVolume(entries []models.ExerciseEntry) float64 {
	var volume float64
	sevenDaysAgo := time.Now().AddDate(0, 0, -7)
	for _, e := range entries {
		if e.CreatedAt.After(sevenDaysAgo) {
			volume += e.Weight
		}
	}
	return volume
}
