package admin

import (
	"time"

	"stren/internal/push"
	"stren/internal/reminders"
	"stren/internal/views"
	"stren/internal/views/components"
)

// AdminNotificationsPage renders the admin "Notifications" page. It
// has two HTMX-driven actions:
//
//   - A "Send" form that posts to /admin/notifications/send and
//     broadcasts a custom push notification to every subscribed
//     device.
//   - A "Send all due reminders now" button that posts to
//     /admin/notifications/send-weight-reminder and fires the same
//     per-user orchestrator the hourly tick uses. The button is
//     the rehearsal-test entry point: the admin can verify the
//     end-to-end SMTP + push pipeline on demand and see exactly
//     which users got the reminder.
//
// Both actions share the same #send-result target so the page has
// one result region. The form clears itself on the
// admin-notification-sent HX-Trigger (broadcast only); the
// reminders button is a one-shot and is not inside a form.
templ AdminNotificationsPage(userName string, isAdmin bool) {
	@views.Layout(views.PageData{Title: "Notifications", UserName: userName, IsAuthenticated: true, IsAdmin: isAdmin, CurrentPath: "/admin/notifications"}) {
		@components.Title(components.TitleProps{Size: "lg", Color: "default", Title: "Notifications"})
		<p class="text-sm text-muted-foreground my-4">Send a push notification to every subscribed device. Use sparingly — a notification goes to every active subscription in the system.</p>
		<form
			id="admin-notifications-form"
			hx-post="/admin/notifications/send"
			hx-target="#send-result"
			hx-swap="innerHTML"
			hx-indicator="#send-spinner"
			hx-on:admin-notification-sent="this.reset()"
			class="form grid gap-6 max-w-full"
		>
			<div class="grid gap-2">
				<label for="title">Title</label>
				<input class="input" type="text" id="title" name="title" placeholder="Notification title" required maxlength="80"/>
			</div>
			<div class="grid gap-2">
				<label for="body">Message</label>
				<textarea class="textarea" id="body" name="body" placeholder="What do you want to tell your users?" required maxlength="500" rows="4"></textarea>
				<p class="text-sm text-muted-foreground">Up to 500 characters. The body becomes the notification text on the user's device.</p>
			</div>
			<div class="grid gap-2">
				<label for="url">URL (optional)</label>
				<input class="input" type="text" id="url" name="url" placeholder="/"/>
				<p class="text-sm text-muted-foreground">If set, tapping the notification opens this URL on the app. Defaults to the dashboard.</p>
			</div>
			<button type="submit" class="btn-primary relative inline-flex">
				<span class="btn-text flex items-center gap-2">
					@components.Icon(components.IconProps{Name: "send", Size: 18})
					Send to all subscribers
				</span>
				<span id="send-spinner" class="htmx-indicator absolute inset-0 flex items-center justify-center animate-spin">
					@components.Icon(components.IconProps{Name: "loader", Size: 18})
				</span>
			</button>
		</form>
		<div class="mt-8 pt-6 border-t">
			<h2 class="text-base font-semibold">Scheduled reminders</h2>
			<p class="text-sm text-muted-foreground my-3">Reminders fire on each user's schedule — users pick frequency, time-of-day, and channels on their profile. Use the button below to fire every due reminder right now (same pipeline the hourly tick uses, so it doubles as a pre-production test).</p>
			<button
				type="button"
				id="weight-reminder-button"
				class="btn-primary relative inline-flex"
				hx-post="/admin/notifications/send-weight-reminder"
				hx-target="#send-result"
				hx-swap="innerHTML"
				hx-indicator="#weight-reminder-spinner"
				hx-disabled-elt="this"
				hx-confirm="Send every due weight reminder right now? This delivers a real email and a real push for every user whose reminder is due."
			>
				<span class="btn-text flex items-center gap-2">
					@components.Icon(components.IconProps{Name: "bell", Size: 18})
					Send all due reminders now
				</span>
				<span id="weight-reminder-spinner" class="htmx-indicator absolute inset-0 flex items-center justify-center animate-spin">
					@components.Icon(components.IconProps{Name: "loader", Size: 18})
				</span>
			</button>
		</div>
		<div id="send-result" class="mt-6">
			@components.Card(components.CardProps{}) {
				@components.CardSection(components.CardSectionProps{}) {
					<p class="text-sm text-muted-foreground">Use the form above to send a notification. Results will appear here.</p>
				}
			}
		</div>
		@WeightReminderConfirmScript()
	}
}

// AdminNotificationResult renders the result card after a broadcast.
// Rendered server-side and swapped into #send-result by HTMX.
templ AdminNotificationResult(result push.BroadcastResult) {
	@components.Card(components.CardProps{}) {
		@components.CardSection(components.CardSectionProps{}) {
			<h3 class="mb-2">Send complete</h3>
			<dl class="grid grid-cols-2 gap-2 text-sm">
				<dt class="text-muted-foreground">Subscribers reached:</dt>
				<dd>{ itoa(result.Sent) }</dd>
				if result.Deleted > 0 {
					<dt class="text-muted-foreground">Dead subscriptions pruned:</dt>
					<dd>{ itoa(result.Deleted) }</dd>
				}
				if result.Failed > 0 {
					<dt class="text-destructive">Failed:</dt>
					<dd class="text-destructive">{ itoa(result.Failed) }</dd>
				}
				<dt class="text-muted-foreground">Total attempted:</dt>
				<dd>{ itoa(result.Total) }</dd>
			</dl>
			if len(result.Errors) > 0 {
				<details class="mt-4">
					<summary class="text-sm text-muted-foreground cursor-pointer">Show error details ({ itoa(len(result.Errors)) })</summary>
					<ul class="mt-2 text-sm space-y-1">
						for _, msg := range result.Errors {
							<li class="text-destructive">{ msg }</li>
						}
					</ul>
				</details>
			}
		}
	}
}

// AdminNotificationNoSubscribers renders a result card for the
// edge case where the broadcast has nothing to send to.
templ AdminNotificationNoSubscribers() {
	@components.Card(components.CardProps{}) {
		@components.CardSection(components.CardSectionProps{}) {
			<p>No subscribers yet. Once users enable push from their profile page they'll appear here.</p>
		}
	}
}

// AdminNotificationError renders an error card when validation or
// the underlying send failed before the broadcast could run.
templ AdminNotificationError(message string) {
	@components.Card(components.CardProps{}) {
		@components.CardSection(components.CardSectionProps{}) {
			<p class="text-destructive">{ message }</p>
		}
	}
}

// AdminWeightReminderResult renders the result card after a tick
// fires the per-user reminder orchestrator. Mirrors the shape of
// AdminNotificationResult so the admin sees a consistent card
// style regardless of which button was clicked.
//
// The summary row shows the aggregate counts the operator cares
// about: how many users were due, total emails sent, total push
// sends, and the run's wall-clock duration. The per-user list
// below breaks each user's outcome into the three states the
// orchestrator can produce (sent / skipped / failed) so the
// operator can see exactly who got the reminder, who had it
// disabled, and who had a transport error — without grepping the
// server log.
templ AdminWeightReminderResult(result reminders.TickResult) {
	@components.Card(components.CardProps{}) {
		@components.CardSection(components.CardSectionProps{}) {
			<h3 class="mb-2">Weight reminders fired</h3>
			<dl class="grid grid-cols-2 gap-2 text-sm">
				<dt class="text-muted-foreground">Users due:</dt>
				<dd>{ itoa(result.Users) }</dd>
				<dt class="text-muted-foreground">Emails sent:</dt>
				<dd>{ itoa(countEmailsSent(result.Results)) }</dd>
				if countEmailsFailed(result.Results) > 0 {
					<dt class="text-destructive">Emails failed:</dt>
					<dd class="text-destructive">{ itoa(countEmailsFailed(result.Results)) }</dd>
				}
				<dt class="text-muted-foreground">Push sent:</dt>
				<dd>{ itoa(countPushSent(result.Results)) }</dd>
				if countPushDeleted(result.Results) > 0 {
					<dt class="text-muted-foreground">Dead subscriptions pruned:</dt>
					<dd>{ itoa(countPushDeleted(result.Results)) }</dd>
				}
				if countPushFailed(result.Results) > 0 {
					<dt class="text-destructive">Push failed:</dt>
					<dd class="text-destructive">{ itoa(countPushFailed(result.Results)) }</dd>
				}
				<dt class="text-muted-foreground">Duration:</dt>
				<dd>{ formatDuration(result.Duration) }</dd>
			</dl>
			if result.Users > 0 {
				<details class="mt-4" open?={ result.Users <= maxWeightReminderPerUserRows }>
					<summary class="text-sm text-muted-foreground cursor-pointer">Per-user outcomes ({ itoa(result.Users) })</summary>
					<ul class="mt-2 text-sm space-y-2">
						for _, r := range result.Results {
							<li class="flex flex-col gap-0.5">
								<span class="font-medium">{ r.UserName } <span class="text-muted-foreground">({ r.UserEmail })</span></span>
								<span>{ reminderOutcomeLabel(r) }</span>
							</li>
						}
					</ul>
					if result.Users > maxWeightReminderPerUserRows {
						<p class="text-sm text-muted-foreground mt-2">Showing all { itoa(result.Users) } users. See the server log for the full per-user error message.</p>
					}
				</details>
			}
		}
	}
}

// maxWeightReminderPerUserRows caps the per-user outcomes list
// rendered inline. The list is collapsed when there are more rows
// than the cap so a quiet operator scan still works on a busy day.
// Mirrors maxWeightReminderFailedAddresses in the previous design
// (which used to cap failed emails; that concept is now a per-user
// outcome, so the cap moves with it).
const maxWeightReminderPerUserRows = 10

// reminderOutcomeLabel renders a one-line summary of a single
// user's reminder outcome: which channels were sent / skipped /
// failed. Pulled into a function (rather than inlined in the
// templ) so the readable string is easy to tweak without
// touching the markup.
//
// The push skip reason is included when present so the
// operator can tell "user has push disabled" from "no active
// push subscriptions" from "push service errored" without
// grepping the server log.
func reminderOutcomeLabel(r reminders.UserReminderResult) string {
	var parts []string
	switch {
	case r.EmailSent:
		parts = append(parts, "email sent")
	case r.EmailFailed:
		parts = append(parts, "email failed")
	case r.EmailSkipped:
		parts = append(parts, "email skipped")
	}
	switch {
	case r.PushSent > 0:
		parts = append(parts, "push sent ("+itoa(r.PushSent)+")")
	case r.PushFailed > 0:
		parts = append(parts, "push failed ("+itoa(r.PushFailed)+")")
	case r.PushSkipped:
		parts = append(parts, "push skipped")
	}
	if r.PushSkipReason != "" && (r.PushFailed > 0 || r.PushSkipped) {
		parts = append(parts, "("+r.PushSkipReason+")")
	}
	if r.Error != "" {
		parts = append(parts, "error: "+r.Error)
	}
	if len(parts) == 0 {
		return "no channels fired"
	}
	out := parts[0]
	for _, p := range parts[1:] {
		out += ", " + p
	}
	return out
}

// countEmailsSent / countEmailsFailed / countPushSent /
// countPushDeleted / countPushFailed fold the per-user result
// slice into the aggregate numbers the summary row needs. Pulled
// into helpers (rather than computed inside the templ) so the
// loop is plain Go and easy to test.
func countEmailsSent(rs []reminders.UserReminderResult) int {
	n := 0
	for _, r := range rs {
		if r.EmailSent {
			n++
		}
	}
	return n
}

func countEmailsFailed(rs []reminders.UserReminderResult) int {
	n := 0
	for _, r := range rs {
		if r.EmailFailed {
			n++
		}
	}
	return n
}

func countPushSent(rs []reminders.UserReminderResult) int {
	n := 0
	for _, r := range rs {
		n += r.PushSent
	}
	return n
}

func countPushDeleted(rs []reminders.UserReminderResult) int {
	n := 0
	for _, r := range rs {
		n += r.PushDeleted
	}
	return n
}

func countPushFailed(rs []reminders.UserReminderResult) int {
	n := 0
	for _, r := range rs {
		n += r.PushFailed
	}
	return n
}

// WeightReminderConfirmScript swaps the global confirm dialog's
// OK button from the destructive (red) default to the
// non-destructive (primary) variant when the weight-reminder
// button is what fired the dialog. The pattern mirrors
// WeightExportScript in internal/views/weight/list.templ: the
// dialog is defined in layout.templ with btn-destructive as the
// safe-looking-but-wrong default for non-destructive actions, and
// each non-destructive caller has to swap it back per show.
//
// `open?={...}` on the details element above means the failed
// addresses list is collapsed only when there are more than the
// cap, so the operator can scan a short list without an extra
// click. This script only runs once per page load and is a
// no-op if the button is not present.
templ WeightReminderConfirmScript() {
	<script>
		(function() {
			var btn = document.getElementById('weight-reminder-button');
			if (!btn) return;

			btn.addEventListener('htmx:confirm', function(evt) {
				// htmx fires htmx:confirm before showing the
				// dialog. Prevent the default (which would
				// show the dialog unmodified) and rebuild it
				// with a non-destructive OK button, the same
				// way the weight export does.
				evt.preventDefault();
				var dialog = document.getElementById('confirm-dialog');
				if (!dialog || typeof dialog.showModal !== 'function') {
					// Fallback: native confirm. A browser
					// without <dialog> support is unlikely
					// in practice, but the fallback keeps
					// the test path simple.
					if (window.confirm(evt.detail.question)) {
						evt.detail.issueRequest(true);
					}
					return;
				}
				var message = document.getElementById('confirm-message');
				if (message) {
					message.textContent = evt.detail.question;
				}
				var ok = document.getElementById('confirm-ok');
				if (ok) {
					var originalOkClass = ok.className;
					ok.className = ok.className.replace(/\bbtn-destructive\b/, 'btn');
					ok.onclick = function() {
						dialog.close();
						evt.detail.issueRequest(true);
					};
					dialog.addEventListener('close', function restoreOkClass() {
						ok.className = originalOkClass;
					}, { once: true });
				}
				dialog.showModal();
			});
		})();
	</script>
}

// itoa is a tiny helper so the templ can render int fields without
// importing strconv into the generated file. Negative numbers are not
// expected (counters are non-negative) so we keep the implementation
// minimal.
func itoa(n int) string {
	if n == 0 {
		return "0"
	}
	digits := []byte{}
	for n > 0 {
		digits = append([]byte{byte('0' + n%10)}, digits...)
		n /= 10
	}
	return string(digits)
}

// formatDuration renders a time.Duration as a short, human-readable
// string for the result card. Lives in Go (not in the templ) so
// the templ file stays focused on markup. The output is a single
// unit (e.g. "1.2s", "850ms") — anything under a second is
// reported in milliseconds, anything at or above in seconds with
// one decimal. Rounded (not truncated) so 949ms reads as 949ms
// rather than 900ms.
func formatDuration(d time.Duration) string {
	if d < 0 {
		d = 0
	}
	if d < time.Second {
		return itoa(int(d.Milliseconds())) + "ms"
	}
	// Seconds with one decimal. d.Seconds() is a float64;
	// multiplying by 10 and rounding keeps the visible
	// precision predictable.
	deciseconds := int(d.Seconds() * 10)
	whole := deciseconds / 10
	frac := deciseconds % 10
	if frac < 0 {
		frac = -frac
	}
	return itoa(whole) + "." + string(rune('0'+frac)) + "s"
}
