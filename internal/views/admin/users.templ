package admin

import (
	"stren/internal/models"
	"stren/internal/views"
	"stren/internal/views/components"
)

// AdminUserList renders the admin page listing all users.
templ AdminUserList(users []models.User, userName string, isAuthenticated bool, isAdmin bool) {
	@views.Layout(views.PageData{Title: "Admin - Users", UserName: userName, IsAuthenticated: isAuthenticated, IsAdmin: isAdmin, CurrentPath: "/admin/users"}) {
		<div class="flex justify-between items-center mb-6">
			@components.Title(components.TitleProps{Size: "lg", Color: "default", Title: "Users"})
		</div>
		if len(users) == 0 {
			<div class="text-center py-12 text-muted-foreground">
				<p>No users yet.</p>
			</div>
		} else {
			<table class="table w-full">
				<thead>
					<tr>
						<th class="hidden lg:table-cell">ID</th>
						<th>Name</th>
						<th>Email</th>
						<th>Admin</th>
						<th>Created</th>
					</tr>
				</thead>
				<tbody>
					for _, u := range users {
						<tr>
							<td class="hidden lg:table-cell">{ u.ID }</td>
							<td>{ u.Name }</td>
							<td>{ u.Email }</td>
							<td>
								if u.IsAdmin {
									<span class="badge badge-success">Yes</span>
								} else {
									<span class="badge">No</span>
								}
							</td>
							<td>{ u.CreatedAt.Format("Jan 02, 2006") }</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}
