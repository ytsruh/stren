package weight

import (
	"stren/internal/views/components"
)

// PhotoUploadProps configures the photo upload widget.
type PhotoUploadProps struct {
	Name       string // Form field name (used for the hidden key input)
	Label      string // Label text (default: "Photo")
	CurrentURL string // Existing photo URL (for edit forms); empty for new entries
	CurrentKey string // Existing photo storage key (for edit forms); empty for new entries
	MaxSizeMB  int    // Max file size in MB; default 5
}

// PhotoUpload renders a photo upload widget that:
//   1. Shows the current photo (if CurrentURL is set) with a "Remove
//      img" button that prompts the global #confirm-dialog before
//      setting the hidden `remove_photo` field. Clicking the button
//      while the remove is pending undoes the action (no confirm).
//   2. Lets the user pick a new file. The upload itself goes
//      directly to R2 via a presigned URL (POST /api/weight/photo-upload
//      returns the URL, the browser PUTs the file). After the
//      upload the JS calls /toast via htmx.ajax to render a
//      views.Toast — keeping the toast markup consistent with the
//      rest of the app (no inline icon SVG duplication).
//
// On form submit, the hidden `photo_key` field carries the new key
// back to the server (or the original if no replacement was
// uploaded). The `remove_photo` hidden field carries "true" when
// the admin has confirmed the removal; the route clears the
// photo on save.
templ PhotoUpload(props PhotoUploadProps) {
	{{ name := photoWidgetName(props.Name) }}
	<div
		class="grid gap-2"
		data-photo-upload={ name }
		data-remove-label="Remove current photo"
		data-undo-label="Undo remove"
		data-confirm-message="Remove this photo? It will be deleted when you save."
	>
		<label for={ "photo-input-" + name }>{ props.Label }</label>
		if props.CurrentURL != "" {
			<div class="flex items-start justify-between gap-3">
				<div id={ "photo-current-" + name } class="flex items-start gap-4 transition-opacity">
					<img
						src={ templ.SafeURL(props.CurrentURL) }
						alt="Current photo"
						class="size-32 rounded-md object-cover border"
					/>
				</div>
				<div class="flex items-center gap-2 pt-1">
					<button
						type="button"
						id={ "photo-remove-" + name }
						class="btn btn-sm-outline"
						title="Remove current photo"
						aria-label="Remove current photo"
						data-state="idle"
					>
						Remove img
					</button>
					<input
						type="hidden"
						id={ "photo-remove-field-" + name }
						name="remove_photo"
						value=""
					/>
				</div>
			</div>
		}
		<input
			class="input pt-2"
			type="file"
			id={ "photo-input-" + name }
			accept="image/*"
		/>
		<input
			type="hidden"
			id={ "photo-key-" + name }
			name="photo_key"
			value={ props.CurrentKey }
		/>
		<div class="flex items-center gap-3">
			<img
				id={ "photo-preview-" + name }
				class="size-32 rounded-md object-cover border hidden"
				alt="New photo preview"
			/>
			<span id={ "photo-spinner-" + name } class="htmx-indicator flex items-center gap-2 text-sm text-muted-foreground">
				<span class="animate-spin">
					@components.Icon(components.IconProps{Name: "loader", Size: 14})
				</span>
				Uploading...
			</span>
		</div>
	</div>
	<script>
		(function() {
			var MAX_SIZE_MB = 5;
			var REMOVE_TEXT = 'Remove img';
			var UNDO_TEXT = 'Undo';
			var ACCEPTED_TYPES_PREFIX = 'image/';

			// showToast clones the right hidden <template>
			// (rendered by the layout's toastTemplate elements)
			// and fills in the title/description. The template
			// owns the icon SVG and the toast structure, so this
			// widget doesn't need to duplicate any of it. The
			// description is omitted from the clone when empty
			// (the template renders an empty <p data-toast-description
			// that we either show or remove).
			function showToast(category, title, message) {
				var toaster = document.getElementById('toaster');
				var template = document.getElementById('toast-template-' + category) || document.getElementById('toast-template-default');
				if (!toaster || !template) return;
				var clone = template.content.cloneNode(true);
				var h2 = clone.querySelector('[data-toast-title]');
				if (h2) h2.textContent = title;
				var p = clone.querySelector('[data-toast-description]');
				if (p) {
					if (message) {
						p.textContent = message;
						p.classList.remove('hidden');
					} else {
						p.remove();
					}
				}
				toaster.appendChild(clone);
			}

			// openConfirm shows the global #confirm-dialog with
			// the given message and resolves when the user clicks
			// the OK button (or rejects when they cancel/close).
			// The OK path must call dialog.close() itself — only
			// the htmx:confirm handler in layout.templ gets a free
			// close via htmx:afterRequest, and we're not on that
			// path.
			function openConfirm(message) {
				return new Promise(function(resolve) {
					var dialog = document.getElementById('confirm-dialog');
					if (!dialog) {
						resolve(window.confirm(message));
						return;
					}
					var msgEl = document.getElementById('confirm-message');
					var okBtn = document.getElementById('confirm-ok');
					if (msgEl) msgEl.textContent = message;
					var onClose = function() {
						dialog.removeEventListener('close', onClose);
						resolve(false);
					};
					dialog.addEventListener('close', onClose);
					okBtn.onclick = function() {
						dialog.removeEventListener('close', onClose);
						dialog.close();
						resolve(true);
					};
					dialog.showModal();
				});
			}

			document.querySelectorAll('[data-photo-upload]').forEach(function(root) {
				if (root.dataset.bound === '1') return;
				root.dataset.bound = '1';
				var name = root.getAttribute('data-photo-upload');
				var maxMB = parseInt(root.getAttribute('data-max-size-mb') || '5', 10) || MAX_SIZE_MB;
				var removeLabel = root.getAttribute('data-remove-label') || 'Remove current photo';
				var undoLabel = root.getAttribute('data-undo-label') || 'Undo remove';
				var confirmMessage = root.getAttribute('data-confirm-message') || 'Remove this photo? It will be deleted when you save.';
				var input = document.getElementById('photo-input-' + name);
				var preview = document.getElementById('photo-preview-' + name);
				var hidden = document.getElementById('photo-key-' + name);
				var current = document.getElementById('photo-current-' + name);
				var removeBtn = document.getElementById('photo-remove-' + name);
				var removeField = document.getElementById('photo-remove-field-' + name);
				var spinner = document.getElementById('photo-spinner-' + name);
				if (!input) return;

				function clearPreview() {
					preview.src = '';
					preview.classList.add('hidden');
				}

				// setRemoveState flips the visual + hidden field to
				// either 'pending' (photo is being removed on save) or
				// 'idle' (no pending removal). The hidden field is
				// '' or 'true' — the route reads it as
				// c.FormValue(...) == "true".
				function setRemoveState(state) {
					if (!removeBtn || !removeField) return;
					if (state === 'pending') {
						removeBtn.dataset.state = 'pending';
						removeBtn.classList.remove('btn-sm-outline');
						removeBtn.classList.add('btn-sm-destructive');
						removeBtn.textContent = UNDO_TEXT;
						removeBtn.title = undoLabel;
						removeBtn.setAttribute('aria-label', undoLabel);
						removeField.value = 'true';
						if (current) current.style.opacity = '0.4';
					} else {
						removeBtn.dataset.state = 'idle';
						removeBtn.classList.add('btn-sm-outline');
						removeBtn.classList.remove('btn-sm-destructive');
						removeBtn.textContent = REMOVE_TEXT;
						removeBtn.title = removeLabel;
						removeBtn.setAttribute('aria-label', removeLabel);
						removeField.value = '';
						if (current) current.style.opacity = '';
					}
				}

				if (removeBtn) {
					removeBtn.addEventListener('click', function(e) {
						if (e && e.preventDefault) e.preventDefault();
						var pending = removeBtn.dataset.state === 'pending';
						if (pending) {
							setRemoveState('idle');
							return;
						}
						openConfirm(confirmMessage).then(function(confirmed) {
							if (!confirmed) return;
							setRemoveState('pending');
							// Confirm the action with a toast so the
							// user knows their click registered.
							// (The actual deletion happens on save.)
							showToast('success', 'Photo marked for removal', 'It will be deleted when you save.');
						});
					});
				}

				input.addEventListener('change', function() {
					var file = input.files && input.files[0];
					if (!file) {
						clearPreview();
						return;
					}
					if (file.type.indexOf(ACCEPTED_TYPES_PREFIX) !== 0) {
						showToast('error', 'Upload failed', 'Please select an image file.');
						input.value = '';
						return;
					}
					if (file.size > maxMB * 1024 * 1024) {
						showToast('error', 'Upload failed', 'File is too large. Max size is ' + maxMB + 'MB.');
						input.value = '';
						return;
					}
					// New photo supersedes any pending remove.
					setRemoveState('idle');
					if (current) current.style.opacity = '';
					// Local preview
					var reader = new FileReader();
					reader.onload = function(e) {
						preview.src = e.target.result;
						preview.classList.remove('hidden');
					};
					reader.readAsDataURL(file);

					// Two-step upload:
					//   1. POST /api/weight/photo-upload → presigned URL
					//   2. PUT  <presigned URL>         → R2
					spinner.classList.remove('htmx-indicator');
					spinner.style.display = 'inline-flex';
					fetch('/api/weight/photo-upload', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ filename: file.name, content_type: file.type })
					}).then(function(r) {
						if (!r.ok) throw new Error('Failed to get upload URL');
						return r.json();
					}).then(function(data) {
						return fetch(data.url, {
							method: 'PUT',
							headers: { 'Content-Type': file.type },
							body: file
						}).then(function(resp) {
							if (!resp.ok) throw new Error('Upload failed (status ' + resp.status + ')');
							hidden.value = data.key;
							showToast('success', 'Photo uploaded', 'Ready to save.');
						});
					}).catch(function(e) {
						showToast('error', 'Upload failed', e.message);
						input.value = '';
						clearPreview();
					}).finally(function() {
						spinner.classList.add('htmx-indicator');
						spinner.style.display = '';
					});
				});
			});
		})();
	</script>
}

// photoWidgetName resolves the name used to scope the widget's DOM
// IDs (photo-input-{name}, photo-preview-{name}, etc.) and its
// data-photo-upload attribute. Empty names are treated as the
// default "photo" so the widget always produces a stable set of
// IDs (an empty suffix would yield "photo-input-" which is not a
// valid id).
func photoWidgetName(name string) string {
	if name == "" {
		return "photo"
	}
	return name
}
